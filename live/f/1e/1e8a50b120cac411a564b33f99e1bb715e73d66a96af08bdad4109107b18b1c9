.rs-bug .rs-modal-panel{width:min(580px,calc(100vw - 32px));text-align:left}
.rs-bug-body{max-height:calc(100vh - 150px);overflow-y:auto;padding:0 6px}
.rs-bug .rs-modal-text{text-align:center;margin:2px 0 10px}
/* One row of five tabs (« Suggestion » alone on a second row looked broken); wraps only on a very narrow screen. */
.rs-bug-cats{display:flex;flex-wrap:nowrap;gap:5px;justify-content:center;margin:0 0 10px}
@media (max-width:440px){.rs-bug-cats{flex-wrap:wrap}}
.rs-bug-cat{flex:1 1 auto;min-width:0;min-height:36px;padding:0 2px;white-space:nowrap;cursor:pointer;background:transparent;color:#c9b98f;
  border-style:solid;border-width:9px 12px;border-image:${e("kit.tab")} 50 70 fill / 9px 12px stretch;image-rendering:pixelated;
  font:700 14px "Almendra",Georgia,serif;text-shadow:0 1px 0 #000,1px 0 0 #000,-1px 0 0 #000;filter:brightness(.72) saturate(.8);transition:filter .12s,transform .08s}
.rs-bug-cat:hover{filter:brightness(1)}
.rs-bug-cat[aria-pressed="true"]{color:#ffe6a8;filter:brightness(1.12) drop-shadow(0 0 6px rgba(255,190,90,.5));transform:translateY(-2px)}
.rs-bug-cat:focus-visible{outline:none;filter:brightness(1.15) drop-shadow(0 0 5px #ffd070)}
.rs-bug-text{display:block;width:100%;height:132px;resize:none;padding:2px 4px;background:transparent;color:#f2e6c8;caret-color:#ffd070;font:15px/1.35 "Alegreya",Georgia,serif;outline:none;
  border-style:solid;border-width:10px 16px;border-image:${e("kit.well")} 22 50 fill / 10px 16px stretch;image-rendering:pixelated}
.rs-bug-text:focus{filter:brightness(1.12) drop-shadow(0 0 5px rgba(255,190,90,.45))}
.rs-bug-text::placeholder{color:#8f7f62}
.rs-bug-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:6px 0 2px;font-size:14px;color:#e4d6b4}
.rs-bug-shot{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.rs-bug-shot input,.rs-bug-replay input{appearance:none;-webkit-appearance:none;flex:none;width:24px;height:24px;margin:0;cursor:pointer;
  background:${e("kit.checkbox")} center/contain no-repeat;image-rendering:pixelated}
.rs-bug-shot input:checked,.rs-bug-replay input:checked{background:${e("kit.check")} 55% 40%/90% no-repeat,${e("kit.checkbox")} center/contain no-repeat}
.rs-bug-shot input:disabled{filter:grayscale(.8) brightness(.6);cursor:default}
.rs-bug-shot img{height:30px;border:1px solid #c9973c;box-shadow:0 0 0 1px #2a1606}
.rs-bug-count{font-variant-numeric:tabular-nums;color:#cdbb94}
.rs-bug-noshot{font-size:12px;line-height:1.3;color:#a89878}
.rs-bug-count.bad{color:#ff9a8a}
.rs-bug-privacy{display:flex;align-items:center;gap:8px;margin:6px 0 0;font-size:14px;line-height:1.3;color:#a89878;text-align:left}
.rs-bug-privacy::before{content:"";flex:none;width:22px;height:22px;background:url("${se("art/ui/icons/ui.quill.png")}") center/contain no-repeat}
.rs-bug .rs-modal-err{text-align:center}
@media (max-height:460px){
  .rs-bug-body{max-height:calc(100vh - 120px)}
  .rs-bug .rs-modal-text{display:none}
  .rs-bug-cats{gap:4px;margin-bottom:6px}
  .rs-bug-cat{min-width:0;min-height:32px;font-size:13px;padding:0 2px}
  .rs-bug-text{height:78px;font-size:14px}
  .rs-bug-meta{font-size:13px;margin-top:4px}
}
.rs-bug-replay{display:flex;align-items:center;gap:8px;margin:6px 0 0;font-size:14px;color:#e4d6b4;cursor:pointer;user-select:none}
/* The class sets display:flex: without this the row showed while [hidden] (no replay to attach). */
.rs-bug [hidden]{display:none!important}
