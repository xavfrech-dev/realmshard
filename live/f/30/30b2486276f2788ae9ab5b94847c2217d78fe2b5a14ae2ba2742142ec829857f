.rs-asc .rs-modal-panel{width:min(760px,calc(100vw - 24px))}
.rs-asc .rs-modal-text{margin:2px 6px 4px;font-size:14px}
.rs-asc-gear{margin:0 6px 10px;font-size:13px;color:#d9b98a;text-shadow:0 1px 0 #000}
.rs-asc-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-flow:column;grid-template-rows:repeat(6,auto);gap:6px 10px;margin:0 2px 12px;text-align:left}
.rs-asc-row{display:flex;align-items:center;gap:8px;min-height:46px;padding:5px 8px 5px 6px;border-radius:6px;border:2px solid #6a4a22;
  background:linear-gradient(180deg,rgba(40,26,14,.92),rgba(16,10,6,.95));color:#f2e6c8;font:inherit;text-align:left;cursor:pointer;transition:filter .12s,transform .08s}
.rs-asc-row:hover:not(.locked){filter:brightness(1.18) drop-shadow(0 0 6px rgba(255,180,80,.45))}
.rs-asc-row:active:not(.locked){transform:scale(.985)}
.rs-asc-row:focus-visible{outline:2px solid #ffd070;outline-offset:1px}
.rs-asc-row.cur{border-color:#ffd27a;box-shadow:0 0 0 1px #ffd27a inset,0 0 10px rgba(255,190,90,.35)}
.rs-asc-row.locked{cursor:default;border-color:#3e3026;background:linear-gradient(180deg,rgba(26,20,16,.92),rgba(10,8,6,.95))}
.rs-asc-medal{flex:0 0 38px;height:38px;display:flex;align-items:center;justify-content:center;border-radius:50%;
