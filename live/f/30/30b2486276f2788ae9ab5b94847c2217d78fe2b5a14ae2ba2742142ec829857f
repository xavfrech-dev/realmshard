.rs-asc-row.a0 .rs-asc-medal{background:radial-gradient(circle at 40% 35%,#6a5228,#2a1e0c)}
.rs-asc-row.locked .rs-asc-medal{border-color:#5a4a3a;background:radial-gradient(circle at 40% 35%,#3a3230,#161210);color:#9a8c7c}
.rs-asc-body{flex:1;min-width:0}
.rs-asc-fx{font-size:13px;line-height:1.25;text-shadow:0 1px 0 #000}
.rs-asc-row.locked .rs-asc-fx{color:#a89c88}
.rs-asc-state{margin-top:2px;font-size:11.5px;letter-spacing:.3px;font-weight:700;color:#cfc2a2;text-shadow:0 1px 0 #000}
.rs-asc-state.won{color:#8ee07a}
