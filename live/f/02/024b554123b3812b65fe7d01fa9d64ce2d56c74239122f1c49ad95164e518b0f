.rs-fp{font-family:"Alegreya",Georgia,serif;color:#f2e6c8;-webkit-tap-highlight-color:transparent}
.rs-fp *{box-sizing:border-box}
.rs-fp-tab{position:fixed;z-index:880;display:flex;align-items:center;gap:6px;padding:8px 12px 8px 10px;cursor:pointer;
  background:linear-gradient(#3a2a1a,#1e140c);border:2px solid #c8a050;border-left:0;border-radius:0 12px 12px 0;color:#ffe6a8;
  font-family:"Almendra",Georgia,serif;font-weight:700;font-size:16px;text-shadow:0 2px 0 #000;box-shadow:0 6px 16px rgba(0,0,0,.6);zoom:var(--fp-z,1)}
.rs-fp-tab:hover{filter:brightness(1.18)}
.rs-fp-tab:focus-visible{outline:2px solid #ffd070;outline-offset:2px}
.rs-fp-tab svg{width:22px;height:22px;flex:none}
.rs-fp-tab .fp-tabsub{display:block;font-family:"Alegreya",Georgia,serif;font-weight:600;font-size:11px;color:#9cffb0;line-height:1}
.fp-badge{min-width:20px;height:20px;padding:0 5px;border-radius:10px;background:#c22a2a;border:1px solid #ffd070;color:#fff;font:700 12px/18px system-ui,sans-serif;text-align:center;text-shadow:none}
.rs-fp-scrim{position:fixed;inset:0;z-index:889;background:rgba(0,0,0,.55)}
.rs-fp-panel{position:fixed;z-index:890;display:flex;flex-direction:column;width:300px;zoom:var(--fp-z,1);
  background:linear-gradient(180deg,rgba(44,30,18,.97),rgba(22,15,9,.97));border:2px solid #c8a050;border-radius:12px;
  box-shadow:0 0 0 1px #2a1a0c,inset 0 0 0 1px rgba(255,214,140,.18),0 14px 30px rgba(0,0,0,.7);overflow:hidden}
.rs-fp--drawer .rs-fp-panel{border-radius:0 12px 12px 0;border-left:0}
.fp-head{display:flex;align-items:center;gap:8px;padding:10px 10px 8px 14px;border-bottom:1px solid rgba(200,160,80,.45);
  background:linear-gradient(#4a321c,#2c1e10)}
.fp-title{flex:1;min-width:0;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:21px;color:#ffe6a8;text-shadow:0 2px 0 #000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fp-me{display:block;font-family:"Alegreya",Georgia,serif;font-size:12px;font-weight:600;color:#cfc2a2}
.fp-x{width:34px;height:34px;flex:none;border-radius:8px;border:1px solid #8a6a3a;background:#1c130b;color:#ffe6a8;font:700 18px/1 Georgia,serif;cursor:pointer}
.fp-x:hover{filter:brightness(1.3)}
.fp-body{flex:1;min-height:0;overflow-y:auto;padding:8px 8px 10px;scrollbar-width:thin;scrollbar-color:#8a6a3a transparent}
.fp-foot{display:flex;gap:6px;padding:8px;border-top:1px solid rgba(200,160,80,.45);background:rgba(0,0,0,.25)}
.fp-foot .fp-btn{flex:1}
.fp-sec{margin:8px 4px 4px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:13px;letter-spacing:.4px;color:#d8b46a;text-transform:uppercase}
.fp-row{display:flex;align-items:center;gap:8px;padding:7px 8px;margin:2px 0;border-radius:8px;cursor:pointer;background:rgba(255,230,170,.04);border:1px solid transparent}
.fp-row:hover,.fp-row.fp-on{background:rgba(255,214,140,.10);border-color:rgba(200,160,80,.5)}
.fp-row.fp-off{opacity:.62}
.fp-dot{width:10px;height:10px;flex:none;border-radius:50%;box-shadow:0 0 0 2px rgba(0,0,0,.6)}
.fp-dot--online{background:#5ee07a;box-shadow:0 0 6px #5ee07a,0 0 0 2px rgba(0,0,0,.6)}
.fp-dot--game{background:#f2b84a;box-shadow:0 0 6px #f2b84a,0 0 0 2px rgba(0,0,0,.6)}
.fp-dot--offline{background:#6a6058}
.fp-who{flex:1;min-width:0}
.fp-name{display:block;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:16px;color:#ffe6a8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 1px 0 #000}
.fp-sub{display:block;font-size:12px;color:#cfc2a2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fp-acts{display:flex;flex-wrap:wrap;gap:5px;padding:2px 6px 8px 26px}
.fp-btn{min-height:32px;padding:0 6px;cursor:pointer;background:transparent;color:#fff4dc;white-space:nowrap;
  border-style:solid;border-width:8px 14px;border-image:${d("kit.buttonStone")} 30 56 fill / 8px 14px stretch;image-rendering:pixelated;
  font-family:"Almendra",Georgia,serif;font-weight:700;font-size:14px;line-height:1;text-shadow:0 2px 0 #0c0806,1px 0 0 #0c0806,-1px 0 0 #0c0806}
.fp-btn--ok{border-image-source:${d("kit.buttonGreen")}}
.fp-btn--bad{border-image-source:${d("kit.buttonRed")}}
.fp-btn--flat{border:1px solid #8a6a3a;border-radius:7px;background:#1c130b;padding:0 10px;border-image:none}
.fp-btn:hover:not(:disabled){filter:brightness(1.2)}
.fp-btn:disabled{cursor:default;filter:grayscale(.8) brightness(.6)}
.fp-btn:focus-visible{outline:2px solid #ffd070;outline-offset:1px}
.fp-card{margin:4px 2px 8px;padding:9px 10px;border-radius:9px;border:1px solid #c8a050;background:linear-gradient(#3a2614,#24170c)}
.fp-card--invite{border-color:#ffd070;background:linear-gradient(#4a2c10,#2a1808);box-shadow:0 0 12px rgba(255,190,90,.25)}
.fp-card p{margin:0 0 7px;font-size:14px;line-height:1.3}
.fp-card .fp-line{display:flex;gap:6px;flex-wrap:wrap}
.fp-muted{font-size:13px;line-height:1.35;color:#cfc2a2;margin:10px 6px}
.fp-note{font-size:11px;line-height:1.3;color:#9a8e74;margin:4px 6px 0}
.fp-ok{color:#9cffb0}.fp-err{color:#ff9a8a}
.fp-input{display:block;width:100%;height:40px;padding:0 12px;border-radius:8px;border:1px solid #8a6a3a;background:#120c07;color:#ffe6a8;
  font-family:"Almendra",Georgia,serif;font-weight:700;font-size:17px;outline:none}
.fp-input:focus{border-color:#ffd070;box-shadow:0 0 0 2px rgba(255,190,90,.25)}
.fp-chathead{display:flex;align-items:center;gap:8px;padding:2px 2px 8px;border-bottom:1px solid rgba(200,160,80,.3)}
.fp-chatacts{display:flex;gap:5px;flex-wrap:wrap;padding:8px 2px}
.fp-msgs{display:flex;flex-direction:column;gap:5px;padding:4px 2px}
.fp-msg{max-width:84%;padding:6px 9px;border-radius:10px;font-size:14px;line-height:1.3;word-wrap:break-word;overflow-wrap:anywhere;background:#33251a;border:1px solid #5a4630;align-self:flex-start}
.fp-msg--me{align-self:flex-end;background:#2c3a22;border-color:#4e6a3a}
.fp-msg time{display:block;font-size:10px;color:#9a8e74;margin-top:2px}
.fp-compose{display:flex;gap:6px;padding:8px;border-top:1px solid rgba(200,160,80,.45);background:rgba(0,0,0,.25)}
.fp-compose .fp-input{height:38px;font-family:"Alegreya",Georgia,serif;font-weight:500;font-size:15px}
.fp-count{font-size:10px;color:#9a8e74;text-align:right;padding:0 10px 4px;background:rgba(0,0,0,.25)}
.fp-radio{display:flex;align-items:center;gap:8px;margin:5px 4px;font-size:14px;cursor:pointer}
.fp-radio input{accent-color:#c8a050;width:16px;height:16px}
