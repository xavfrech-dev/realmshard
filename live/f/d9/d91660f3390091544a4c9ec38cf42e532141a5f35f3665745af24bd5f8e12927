.rs-gc{position:fixed;z-index:860;font-family:"Alegreya",Georgia,serif;color:#f2e6c8;-webkit-tap-highlight-color:transparent}
.rs-gc *{box-sizing:border-box}
.gc-win{display:flex;flex-direction:column;width:${De}px;height:${ks}px;transform-origin:0 0}
.gc-head{display:flex;align-items:center;gap:10px;padding:2px 6px 6px;border-bottom:1px solid rgba(200,160,80,.35)}
.gc-title{font-family:"Almendra",Georgia,serif;font-weight:700;font-size:18px;color:#ffe27a;text-shadow:0 2px 0 #000;white-space:nowrap}
.gc-note{flex:1;min-width:0;font-size:12px;line-height:1.25;color:#b8a888}
.gc-mute{margin:6px 4px 0;padding:6px 10px;border-radius:8px;border:1px solid #ffc070;background:rgba(80,40,10,.6);color:#ffd27a;font-size:13px;font-weight:700}
.gc-msgs{flex:1;min-height:0;overflow-y:auto;padding:6px 4px;display:flex;flex-direction:column;gap:4px;scrollbar-width:thin;scrollbar-color:#8a6a3a transparent}
.gc-msg{padding:5px 9px;border-radius:9px;background:rgba(51,37,26,.85);border:1px solid #5a4630;font-size:15px;line-height:1.3;overflow-wrap:anywhere;cursor:pointer;max-width:88%;align-self:flex-start}
.gc-msg--me{align-self:flex-end;background:rgba(44,58,34,.9);border-color:#4e6a3a;cursor:default}
.gc-msg:hover:not(.gc-msg--me){border-color:#c8a050}
.gc-who{font-family:"Almendra",Georgia,serif;font-weight:700;font-size:14px;margin-right:6px}
.gc-who--leader{color:#ffd24a}.gc-who--officer{color:#8ad0ff}.gc-who--member{color:#e6d2a8}
.gc-tag{font-size:11px;color:#ffc070;margin-right:6px}
.gc-msg time{font-size:11px;color:#9a8e74;margin-left:4px}
.gc-acts{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.gc-acts p{margin:0 0 4px;width:100%;font-size:13px;color:#ffe6a8}
.gc-empty{margin:auto;font-size:15px;color:#cfc2a2;text-align:center;padding:20px}
.gc-compose{display:flex;gap:6px;padding-top:6px;border-top:1px solid rgba(200,160,80,.35)}
.gc-input{flex:1;min-width:0;height:38px;padding:0 12px;border-radius:8px;border:1px solid #8a6a3a;background:#120c07;color:#ffe6a8;
  font-family:"Alegreya",Georgia,serif;font-weight:500;font-size:16px;outline:none}
.gc-input:focus{border-color:#ffd070;box-shadow:0 0 0 2px rgba(255,190,90,.25)}
.gc-input:disabled{opacity:.55}
.gc-foot{display:flex;justify-content:space-between;gap:8px;font-size:11px;color:#9a8e74;padding:2px 4px 0}
.gc-err{color:#ff9a8a}
.gc-btn{min-height:30px;padding:0 10px;cursor:pointer;background:#1c130b;color:#fff4dc;white-space:nowrap;border:1px solid #8a6a3a;border-radius:7px;
  font-family:"Almendra",Georgia,serif;font-weight:700;font-size:14px;line-height:1;text-shadow:0 2px 0 #0c0806}
.gc-btn--ok,.gc-btn--bad,.gc-btn--stone{border-style:solid;border-width:8px 14px;border-radius:0;background:transparent;padding:0 6px;
  border-image:${n("kit.buttonStone")} 30 56 fill / 8px 14px stretch;image-rendering:pixelated}
.gc-btn--ok{border-image-source:${n("kit.buttonGreen")}}
.gc-btn--bad{border-image-source:${n("kit.buttonRed")}}
.gc-btn:hover:not(:disabled){filter:brightness(1.2)}
.gc-btn:disabled{cursor:default;filter:grayscale(.8) brightness(.6)}
.gc-btn:focus-visible,.gc-msg:focus-visible{outline:2px solid #ffd070;outline-offset:1px}
