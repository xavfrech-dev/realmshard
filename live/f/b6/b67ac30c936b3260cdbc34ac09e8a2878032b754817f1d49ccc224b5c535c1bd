.rs-gift-list{display:flex;flex-direction:column;gap:6px;margin:0 0 14px}
.rs-gift-item{display:flex;align-items:center;justify-content:center;gap:10px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:18px;color:#ffe6a8;text-shadow:0 1px 0 #000}
.rs-gift-item img{width:34px;height:34px;image-rendering:pixelated;filter:drop-shadow(0 2px 2px rgba(0,0,0,.8))}
.rs-gift-extra{font-size:16px;color:#ffd75a}
.rs-gift-extra i{font-style:normal;width:34px;text-align:center;font-size:20px;color:#f2c640;text-shadow:0 0 6px rgba(255,215,90,.8),0 1px 0 #000}
.rs-gift-foot{font-size:13px;opacity:.92;margin:0 4px 12px}
.rs-daily .rs-modal-panel{width:min(560px,calc(100vw - 24px))}
.rs-daily .rs-modal-text{margin:2px 4px 12px}
.rs-cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin:0 0 10px}
.rs-cal-day{position:relative;padding:5px 2px 6px;border-radius:6px;border:2px solid #6a4a22;background:linear-gradient(180deg,rgba(40,26,14,.92),rgba(16,10,6,.95));
  color:#f2e6c8;min-height:96px;display:flex;flex-direction:column;gap:2px;align-items:center;justify-content:flex-start}
.rs-cal-day strong{font-family:"Almendra",Georgia,serif;font-size:13px;line-height:1.1;color:#f2c640;text-shadow:0 1px 0 #000;white-space:nowrap}
.rs-cal-items{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
.rs-cal-item{display:flex;flex-direction:column;align-items:center;line-height:1}
.rs-cal-item img{width:36px;height:36px;image-rendering:pixelated;filter:drop-shadow(0 2px 2px rgba(0,0,0,.8))}
.rs-cal-item b{font-family:"Almendra",Georgia,serif;font-size:15px;color:#ffe6a8;text-shadow:0 1px 0 #000,0 0 2px #000}
.rs-cal-day.multi .rs-cal-items{flex-direction:row;flex-wrap:nowrap;gap:0 2px}
.rs-cal-day.multi .rs-cal-item img{width:24px;height:24px}
.rs-cal-day.multi .rs-cal-item b{font-size:13px}
.rs-cal-day.big{border-color:#a8781e;background:linear-gradient(180deg,rgba(70,44,14,.95),rgba(24,14,6,.96))}
.rs-cal-day.today{border-color:#ffd75a;transform:translateY(-3px);box-shadow:0 0 0 1px #000,0 0 12px rgba(255,215,90,.75);
  background:linear-gradient(180deg,rgba(96,66,18,.96),rgba(34,22,8,.96))}
.rs-cal-day.today strong{color:#fff4c0}
.rs-cal-day.done>:not(.rs-cal-tick){filter:grayscale(.6) brightness(.6)}
.rs-cal-day.done{border-color:#3e5a2a}
.rs-cal-tick{position:absolute;right:-6px;bottom:-6px;width:22px;height:22px;border-radius:50%;background:#2f8a2a;border:2px solid #0c1a08;
  display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#eaffd8;box-shadow:0 1px 3px rgba(0,0,0,.8)}
.rs-gift-got{min-height:22px;margin:0 0 10px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:16px;color:#9be08a;text-shadow:0 1px 0 #000}
.rs-daily .rs-modal-btn{max-width:210px}
.rs-squire .rs-modal-panel{width:min(760px,calc(100vw - 24px))}
.rs-squire .rs-modal-text{margin:2px 6px 10px}
.rs-sq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 8px;margin:0 0 8px;text-align:left}
.rs-sq-step{display:flex;align-items:center;gap:8px;min-height:50px;padding:5px 8px;border-radius:6px;border:2px solid #6a4a22;
  background:linear-gradient(180deg,rgba(40,26,14,.92),rgba(16,10,6,.95))}
.rs-sq-mark{width:24px;height:24px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;
  font-weight:700;font-size:14px;color:#2a1406;background:#8a7a5a;box-shadow:0 0 0 1px #000}
.rs-sq-mark img{width:22px;height:22px;image-rendering:pixelated}
.rs-sq-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.rs-sq-name{font-family:"Almendra",Georgia,serif;font-weight:700;font-size:15px;line-height:1.15;color:#f2e6c8;text-shadow:0 1px 0 #000}
.rs-sq-reward{display:flex;align-items:center;gap:4px;font-size:13px;color:#ffe6a8;text-shadow:0 1px 0 #000}
.rs-sq-reward img{width:18px;height:18px;image-rendering:pixelated}
.rs-sq-lock{font-size:12px;color:#ffd27a}
.rs-sq-step .rs-modal-btn{flex:none;width:118px;height:40px;font-size:15px;border-width:12px 22px;border-image-width:12px 22px}
.rs-sq-tag{flex:none;font-size:13px;font-weight:700;color:#9a8a6a}
.rs-sq-step.ready{border-color:#e2b350;box-shadow:0 0 8px rgba(255,200,90,.45)}
.rs-sq-step.ready .rs-sq-mark{background:#f2c640}
.rs-sq-step.claimed{border-color:#3e5a2a}
.rs-sq-step.claimed .rs-sq-mark{background:#2f8a2a;color:#eaffd8}
.rs-sq-step.claimed .rs-sq-body{filter:grayscale(.5) brightness(.75)}
.rs-sq-step.locked .rs-sq-mark{background:none;box-shadow:none}
.rs-sq-step.locked .rs-sq-name{color:#b8ac94}
.rs-sq-final{margin:0 6px 4px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:15px;color:#ffd75a;text-shadow:0 1px 0 #000}
