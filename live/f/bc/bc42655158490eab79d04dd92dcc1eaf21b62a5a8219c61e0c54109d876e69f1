import{ds as d,di as u}from"./content-CAitIufH.js";const e={tab:"Leçons",header:"De courts duels guidés pour maîtriser les mécaniques avancées. Rejouables à volonté, récompensés la 1re fois.",progress:"Leçons terminées : {n}/{total}",play:"Jouer",replay:"Rejouer",done:"Terminée",reward:"+{gold} Or · +{shards} Éclats",quit:"Quitter la leçon",foe:"Instructeur d’armes",finished:"Leçon terminée : {title}",doneLine:"Leçon réussie ! Rejoue-la quand tu veux depuis Codex › Leçons.","combo.title":"Combo","combo.blurb":"Un bonus si tu as déjà joué une carte ce tour-ci.","combo.intro":"Combo : une carte avec Combo gagne un bonus si tu as déjà joué une autre carte ce tour-ci. Le pouvoir héroïque ne compte pas.","combo.first":"Seul, {b} inflige 2 dégâts : pas assez pour les 4 PV de l’instructeur. Joue d’abord {a}.","combo.ready":"Une carte est jouée : le Combo de {b} est actif. Ses 2 dégâts de plus portent le total à 4.","combo.finish":"Coup de grâce. Joue {b} sur le héros adverse.","combo.done":"Bravo ! L’ordre compte : garde tes cartes Combo pour après une carte bon marché.","overload.title":"Surcharge","overload.blurb":"Un effet fort tout de suite, du mana en moins au tour suivant.","overload.intro":"Surcharge : la carte coûte peu, mais verrouille des cristaux de mana pendant ton prochain tour. {a} coûte 1 et a Surcharge (1).","overload.cast":"4 dégâts pour 1 mana, c’est beaucoup. Joue {a} sur {b}.","overload.owed":"La dette est inscrite : au prochain tour, 1 cristal sera verrouillé (cadenas sur ta barre de mana).","overload.endTurn":"Voyons cela. Termine ton tour.","overload.locked":"Tu as 4 cristaux, mais 1 est verrouillé : 3 mana seulement ce tour-ci. Au tour suivant, tout revient.","overload.done":"Retiens-le : joue tes cartes à Surcharge quand tu n’auras pas besoin de tout ton mana au tour suivant.","echo.title":"Écho","echo.blurb":"Ton prochain sort ou Cri de guerre se déclenche deux fois.","echo.intro":"Ton héros a 1 Écho (son icône est à gauche de l’écran, avec tes effets). En Histoire, des reliques comme la Flûte d’os t’en donnent au début du combat.","echo.play":"L’Écho double ton prochain sort (hors attaque) ou le prochain Cri de guerre, puis il est consommé. Joue {a}.","echo.doubled":"Le Cri de guerre s’est déclenché deux fois : {b} a gagné +1 Attaque deux fois, il frappe maintenant pour 5.","echo.attack":"L’instructeur n’a que 5 PV. Attaque le héros adverse avec {b}.","echo.done":"Bien vu ! Garde l’Écho pour une carte dont l’effet doublé change la partie.","tauntStealth.title":"Provocation et Camouflage","tauntStealth.blurb":"Qui doit-on frapper d’abord, et qui ne peut pas être visé.","tauntStealth.taunt":"{a} a Provocation (bouclier) : tant qu’il est là, tes attaques doivent le viser en premier.","tauntStealth.attackTaunt":"Tu ne peux frapper ni le héros ni l’autre serviteur. Attaque {a} avec {c}.","tauntStealth.stealth":"{b} a Camouflage (voile sombre) : impossible de l’attaquer ou de le viser avec un sort tant qu’il n’a pas attaqué.","tauntStealth.endTurn":"Patience. Termine ton tour.","tauntStealth.revealed":"Il a attaqué ton héros : son Camouflage est tombé. Le voilà à découvert.","tauntStealth.attackIt":"À toi de jouer. Attaque {b} avec {c}.","tauntStealth.done":"Parfait ! Abats les Provocations pour atteindre le héros, et frappe un serviteur camouflé dès qu’il se dévoile.","aimedBattlecry.title":"Cri de guerre ciblé","aimedBattlecry.blurb":"Choisir la cible d’un Cri de guerre, et ses conditions.","aimedBattlecry.intro":"Certains Cris de guerre visent une cible. Pose le serviteur sur le plateau, puis choisis sa cible avec la flèche.","aimedBattlecry.rule":"Lis bien la condition : {a} ne prend que les serviteurs d’Attaque 1 ou moins. {c} (3 Attaque) n’est pas une cible valide, seul {b} est éclairé.","aimedBattlecry.play":"Vole le garde. Joue {a}, puis vise {b}.","aimedBattlecry.done":"Bien joué ! Sans cible valide, un Cri de guerre ciblé se joue quand même, mais sans effet : vérifie la condition avant de dépenser ton mana.","discover.title":"Découverte","discover.blurb":"Choisir une carte parmi trois cartes de ta classe.","discover.intro":"Découverte : tu choisis une carte parmi trois cartes de ta classe tirées au hasard. Elle va dans ta main.","discover.play":"Choisis selon la situation : une réponse, une menace, ou de quoi tenir. Joue {a}, puis prends la carte qui te plaît.","discover.found":"La carte choisie est dans ta main, prête à être jouée à un prochain tour.","discover.done":"Voilà ! La Découverte ne pioche pas au hasard : c’est toi qui choisis.","pact.title":"Pacte","pact.blurb":"La Brèche : ton héros paie en PV un effet puissant.","pact.intro":"Pacte (N), venu de la Brèche : ton héros subit N dégâts pour un effet plus fort que son coût en mana.","pact.price":"Surveille tes PV avant de signer : à 12 PV, le Pacte (2) de {a} te laissera à 10. Un Pacte peut te tuer !","pact.cast":"6 dégâts pour 3 mana : de quoi achever l’instructeur. Joue {a} sur le héros adverse.","pact.done":"Pacte honoré ! Puissant quand tu mènes, dangereux quand tes PV sont bas.","deathrattle.title":"Râle d’agonie","deathrattle.blurb":"Un effet qui se déclenche à la mort du serviteur.","deathrattle.intro":"Râle d’agonie : l’effet se déclenche quand le serviteur meurt. {a} invoque un {c} à sa mort.","deathrattle.attack":"Sa mort n’est pas une perte. Attaque {b} avec {a}.","deathrattle.spirit":"Les deux serviteurs sont morts, et le Râle d’agonie a laissé {c} à sa place, avec Provocation.","deathrattle.done":"Exactement ! Un serviteur à Râle d’agonie gagne souvent l’échange, même en mourant.","secret.title":"Secret","secret.blurb":"Un piège caché qui se déclenche au tour adverse.","secret.intro":"Un Secret se pose sur ton héros, face cachée, et attend que l’adversaire déclenche sa condition. {a} punit le prochain serviteur qu’il joue.","secret.play":"Pose le piège. Joue {a}.","secret.hidden":"Ton Secret est actif (sceau violet au-dessus de ton portrait). L’adversaire sait qu’il y en a un, mais pas lequel.","secret.endTurn":"Laisse-le venir. Termine ton tour.","secret.sprung":"Il a joué {b} : ton Secret s’est révélé et lui a infligé 4 dégâts. Le piège a fonctionné !","secret.done":"Pense aussi aux Secrets adverses : un « ? » sur son portrait doit te rendre prudent."},c={tab:"Lessons",header:"Short guided duels to master the advanced mechanics. Replay them at will; the first clear is rewarded.",progress:"Lessons completed: {n}/{total}",play:"Play",replay:"Replay",done:"Completed",reward:"+{gold} Gold · +{shards} Shards",quit:"Quit the lesson",foe:"Arms Instructor",finished:"Lesson completed: {title}",doneLine:"Lesson complete! Replay it any time from Codex › Lessons.","combo.title":"Combo","combo.blurb":"A bonus if you already played a card this turn.","combo.intro":"Combo: a card with Combo gets a bonus if you already played another card this turn. Your Hero Power doesn’t count.","combo.first":"On its own, {b} deals 2 damage: not enough for the instructor’s 4 HP. Play {a} first.","combo.ready":"One card played: the Combo of {b} is active. Its 2 extra damage bring the total to 4.","combo.finish":"Finishing blow. Play {b} on the enemy hero.","combo.done":"Well done! Order matters: keep your Combo cards for after a cheap card.","overload.title":"Overload","overload.blurb":"A strong effect now, less mana next turn.","overload.intro":"Overload: the card is cheap, but locks mana crystals during your next turn. {a} costs 1 and has Overload (1).","overload.cast":"4 damage for 1 mana is a lot. Play {a} on {b}.","overload.owed":"The debt is noted: next turn, 1 crystal will be locked (padlock on your mana bar).","overload.endTurn":"Let’s see. End your turn.","overload.locked":"You have 4 crystals, but 1 is locked: only 3 mana this turn. Next turn, everything comes back.","overload.done":"Remember: play your Overload cards when you won’t need all your mana next turn.","echo.title":"Echo","echo.blurb":"Your next spell or Battlecry triggers twice.","echo.intro":"Your hero has 1 Echo (its icon is on the left of the screen, with your effects). In the Story, relics such as the Bone Flute give you some at the start of a fight.","echo.play":"Echo doubles your next spell (attacks aside) or your next Battlecry, then it is used up. Play {a}.","echo.doubled":"The Battlecry triggered twice: {b} gained +1 Attack twice and now hits for 5.","echo.attack":"The instructor has only 5 HP. Attack the enemy hero with {b}.","echo.done":"Nicely done! Save Echo for a card whose doubled effect turns the game.","tauntStealth.title":"Taunt and Stealth","tauntStealth.blurb":"Who must be hit first, and who can’t be targeted.","tauntStealth.taunt":"{a} has Taunt (shield): while it stands, your attacks must hit it first.","tauntStealth.attackTaunt":"You can hit neither the hero nor the other minion. Attack {a} with {c}.","tauntStealth.stealth":"{b} has Stealth (dark veil): it can’t be attacked or targeted by spells until it attacks.","tauntStealth.endTurn":"Patience. End your turn.","tauntStealth.revealed":"It attacked your hero: its Stealth is gone. Now it is out in the open.","tauntStealth.attackIt":"Your move. Attack {b} with {c}.","tauntStealth.done":"Perfect! Take down Taunts to reach the hero, and strike a stealthed minion as soon as it shows itself.","aimedBattlecry.title":"Targeted Battlecry","aimedBattlecry.blurb":"Choosing a Battlecry’s target, and its conditions.","aimedBattlecry.intro":"Some Battlecries aim at a target. Put the minion on the board, then choose its target with the arrow.","aimedBattlecry.rule":"Read the condition: {a} only takes minions with 1 Attack or less. {c} (3 Attack) is not a valid target; only {b} lights up.","aimedBattlecry.play":"Steal the guard. Play {a}, then aim at {b}.","aimedBattlecry.done":"Well played! With no valid target, a targeted Battlecry can still be played, but does nothing: check the condition before spending your mana.","discover.title":"Discover","discover.blurb":"Choose one of three cards of your class.","discover.intro":"Discover: you choose one of three random cards of your class. It goes to your hand.","discover.play":"Pick for the situation: an answer, a threat, or something to hold on. Play {a}, then take the card you like.","discover.found":"The card you chose is in your hand, ready for a later turn.","discover.done":"There you go! Discover isn’t a random draw: you make the choice.","pact.title":"Pact","pact.blurb":"The Breach: your hero pays HP for a strong effect.","pact.intro":"Pact (N), from the Breach: your hero takes N damage for an effect stronger than its mana cost.","pact.price":"Watch your HP before you sign: at 12 HP, the Pact (2) of {a} leaves you at 10. A Pact can kill you!","pact.cast":"6 damage for 3 mana: enough to finish the instructor. Play {a} on the enemy hero.","pact.done":"Pact honoured! Strong when you are ahead, dangerous when your HP are low.","deathrattle.title":"Deathrattle","deathrattle.blurb":"An effect that triggers when the minion dies.","deathrattle.intro":"Deathrattle: the effect triggers when the minion dies. {a} summons a {c} when it dies.","deathrattle.attack":"Its death is no loss. Attack {b} with {a}.","deathrattle.spirit":"Both minions died, and the Deathrattle left {c} in its place, with Taunt.","deathrattle.done":"Exactly! A Deathrattle minion often wins the trade, even as it dies.","secret.title":"Secret","secret.blurb":"A hidden trap that triggers on the opponent’s turn.","secret.intro":"A Secret sits on your hero, face down, until the opponent meets its condition. {a} punishes the next minion they play.","secret.play":"Set the trap. Play {a}.","secret.hidden":"Your Secret is active (purple seal above your portrait). The opponent knows there is one, but not which.","secret.endTurn":"Let them come. End your turn.","secret.sprung":"They played {b}: your Secret revealed itself and dealt 4 damage to it. The trap worked!","secret.done":"Mind the opponent’s Secrets too: a « ? » on their portrait should make you careful."},h={tab:"Lektionen",header:"Kurze geführte Duelle, um die fortgeschrittenen Mechaniken zu meistern. Beliebig oft wiederholbar, beim ersten Mal belohnt.",progress:"Abgeschlossene Lektionen: {n}/{total}",play:"Spielen",replay:"Wiederholen",done:"Abgeschlossen",reward:"+{gold} Gold · +{shards} Splitter",quit:"Lektion verlassen",foe:"Waffenlehrer",finished:"Lektion abgeschlossen: {title}",doneLine:"Lektion geschafft! Wiederhole sie jederzeit unter Kodex › Lektionen.","combo.title":"Combo","combo.blurb":"Ein Bonus, wenn du in diesem Zug schon eine Karte gespielt hast.","combo.intro":"Combo: Eine Karte mit Combo erhält einen Bonus, wenn du in diesem Zug schon eine andere Karte gespielt hast. Die Heldenfähigkeit zählt nicht.","combo.first":"Allein verursacht {b} 2 Schaden: zu wenig für die 4 LP des Lehrers. Spiel zuerst {a}.","combo.ready":"Eine Karte ist gespielt: Die Combo von {b} ist aktiv. Ihre 2 zusätzlichen Schaden ergeben insgesamt 4.","combo.finish":"Der Gnadenstoß. Spiel {b} auf den gegnerischen Helden.","combo.done":"Bravo! Die Reihenfolge zählt: Heb dir Combo-Karten für nach einer billigen Karte auf.","overload.title":"Überladung","overload.blurb":"Ein starker Effekt sofort, weniger Mana im nächsten Zug.","overload.intro":"Überladung: Die Karte ist billig, sperrt aber Manakristalle in deinem nächsten Zug. {a} kostet 1 und hat Überladung (1).","overload.cast":"4 Schaden für 1 Mana ist viel. Spiel {a} auf {b}.","overload.owed":"Die Schuld ist vermerkt: Im nächsten Zug ist 1 Kristall gesperrt (Schloss auf deiner Manaleiste).","overload.endTurn":"Mal sehen. Beende deinen Zug.","overload.locked":"Du hast 4 Kristalle, aber 1 ist gesperrt: nur 3 Mana in diesem Zug. Im nächsten Zug ist alles wieder da.","overload.done":"Merk dir: Spiel Überladungskarten, wenn du im nächsten Zug nicht dein ganzes Mana brauchst.","echo.title":"Echo","echo.blurb":"Dein nächster Zauber oder Kampfschrei wird zweimal ausgelöst.","echo.intro":"Dein Held hat 1 Echo (sein Symbol ist links am Bildschirmrand, bei deinen Effekten). In der Geschichte geben dir Relikte wie die Knochenflöte zu Kampfbeginn welches.","echo.play":"Echo verdoppelt deinen nächsten Zauber (außer Angriffen) oder deinen nächsten Kampfschrei und ist dann verbraucht. Spiel {a}.","echo.doubled":"Der Kampfschrei wurde zweimal ausgelöst: {b} hat zweimal +1 Angriff erhalten und schlägt jetzt mit 5 zu.","echo.attack":"Der Lehrer hat nur 5 LP. Greif den gegnerischen Helden mit {b} an.","echo.done":"Gut gemacht! Heb dir Echo für eine Karte auf, deren doppelter Effekt die Partie entscheidet.","tauntStealth.title":"Spott und Verstohlenheit","tauntStealth.blurb":"Wen man zuerst treffen muss, und wen man nicht anvisieren kann.","tauntStealth.taunt":"{a} hat Spott (Schild): Solange er steht, müssen deine Angriffe zuerst ihn treffen.","tauntStealth.attackTaunt":"Du kannst weder den Helden noch den anderen Diener angreifen. Greif {a} mit {c} an.","tauntStealth.stealth":"{b} hat Verstohlenheit (dunkler Schleier): Er kann nicht angegriffen oder mit Zaubern anvisiert werden, bis er angreift.","tauntStealth.endTurn":"Geduld. Beende deinen Zug.","tauntStealth.revealed":"Er hat deinen Helden angegriffen: Seine Verstohlenheit ist weg. Jetzt steht er ungeschützt da.","tauntStealth.attackIt":"Du bist dran. Greif {b} mit {c} an.","tauntStealth.done":"Perfekt! Schalte Spott-Diener aus, um den Helden zu erreichen, und triff einen verstohlenen Diener, sobald er sich zeigt.","aimedBattlecry.title":"Gezielter Kampfschrei","aimedBattlecry.blurb":"Das Ziel eines Kampfschreis wählen, und seine Bedingungen.","aimedBattlecry.intro":"Manche Kampfschreie brauchen ein Ziel. Leg den Diener aufs Spielfeld und wähle dann sein Ziel mit dem Pfeil.","aimedBattlecry.rule":"Lies die Bedingung: {a} nimmt nur Diener mit 1 Angriff oder weniger. {c} (3 Angriff) ist kein gültiges Ziel, nur {b} leuchtet auf.","aimedBattlecry.play":"Stiehl die Wache. Spiel {a} und ziele dann auf {b}.","aimedBattlecry.done":"Gut gespielt! Ohne gültiges Ziel lässt sich ein gezielter Kampfschrei trotzdem spielen, aber ohne Wirkung: Prüf die Bedingung, bevor du Mana ausgibst.","discover.title":"Entdeckt","discover.blurb":"Eine von drei Karten deiner Klasse wählen.","discover.intro":"Entdeckt: Du wählst eine von drei zufälligen Karten deiner Klasse. Sie kommt auf deine Hand.","discover.play":"Wähl nach der Lage: eine Antwort, eine Bedrohung oder etwas zum Durchhalten. Spiel {a} und nimm dann die Karte, die dir gefällt.","discover.found":"Die gewählte Karte ist auf deiner Hand, bereit für einen späteren Zug.","discover.done":"Bitte sehr! Entdeckt ist kein Zufallszug: Du triffst die Wahl.","pact.title":"Pakt","pact.blurb":"Die Bresche: Dein Held zahlt LP für einen starken Effekt.","pact.intro":"Pakt (N), aus der Bresche: Dein Held erleidet N Schaden für einen Effekt, der stärker ist als seine Manakosten.","pact.price":"Achte auf deine LP, bevor du unterschreibst: Mit 12 LP lässt dich der Pakt (2) von {a} bei 10. Ein Pakt kann dich töten!","pact.cast":"6 Schaden für 3 Mana: genug, um den Lehrer zu erledigen. Spiel {a} auf den gegnerischen Helden.","pact.done":"Pakt erfüllt! Stark, wenn du vorne liegst, gefährlich bei wenig LP.","deathrattle.title":"Todesröcheln","deathrattle.blurb":"Ein Effekt, der beim Tod des Dieners ausgelöst wird.","deathrattle.intro":"Todesröcheln: Der Effekt wird ausgelöst, wenn der Diener stirbt. {a} ruft bei seinem Tod einen {c} herbei.","deathrattle.attack":"Sein Tod ist kein Verlust. Greif {b} mit {a} an.","deathrattle.spirit":"Beide Diener sind tot, und das Todesröcheln hat {c} mit Spott an seiner Stelle hinterlassen.","deathrattle.done":"Genau! Ein Diener mit Todesröcheln gewinnt den Tausch oft, selbst wenn er stirbt.","secret.title":"Geheimnis","secret.blurb":"Eine verborgene Falle, die im gegnerischen Zug zuschnappt.","secret.intro":"Ein Geheimnis liegt verdeckt auf deinem Helden, bis der Gegner seine Bedingung erfüllt. {a} bestraft den nächsten Diener, den er spielt.","secret.play":"Stell die Falle. Spiel {a}.","secret.hidden":"Dein Geheimnis ist aktiv (violettes Siegel über deinem Porträt). Der Gegner weiß, dass es eines gibt, aber nicht welches.","secret.endTurn":"Lass ihn kommen. Beende deinen Zug.","secret.sprung":"Er hat {b} gespielt: Dein Geheimnis hat sich enthüllt und ihm 4 Schaden zugefügt. Die Falle hat funktioniert!","secret.done":"Denk auch an gegnerische Geheimnisse: Ein „?“ an seinem Porträt sollte dich vorsichtig machen."},m={fr:e,en:c,de:h};function g(t,a){const s=m[d()]??e,n=`${t}.touch`,r=u()&&n in e?n:t,i=s[r]??e[r]??t;return a?i.replace(/\{(\w+)\}/g,(l,o)=>o in a?String(a[o]):l):i}export{g as l};
