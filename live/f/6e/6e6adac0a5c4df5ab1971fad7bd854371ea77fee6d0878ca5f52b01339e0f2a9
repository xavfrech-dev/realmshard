  font:700 13px var(--rs-font-title);text-shadow:var(--rs-stroke);transition:filter .12s,transform .08s}
.rs-rp-btn:hover{filter:brightness(1.2) var(--rs-glow)}
.rs-rp-btn:active{transform:scale(.96)}
.rs-rp-btn--go{border-image-source:${t("kit.buttonGreen")}}
.rs-rp-btn:focus-visible{outline:none;filter:brightness(1.15) drop-shadow(0 0 5px #ffd070)}
.rs-rp-empty{padding:18px 8px;text-align:center;color:var(--rs-muted);font-size:15px}
.rs-rp-code{display:block;width:100%;height:120px;resize:none;padding:4px;background:transparent;color:var(--rs-text);font:12px/1.3 ui-monospace,Consolas,monospace;word-break:break-all;outline:none;
