.rs-rp-btn:hover{filter:brightness(1.2) var(--rs-glow)}
.rs-rp-btn:active{transform:scale(.96)}
.rs-rp-btn--go{border-image-source:${e("kit.buttonGreen")}}
.rs-rp-btn:focus-visible{outline:none;filter:brightness(1.15) drop-shadow(0 0 5px #ffd070)}
