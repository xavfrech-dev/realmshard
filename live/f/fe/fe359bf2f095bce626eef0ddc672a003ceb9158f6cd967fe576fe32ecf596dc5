.rs-rp .rs-modal-panel{width:min(720px,calc(100vw - 24px));text-align:left}
.rs-rp-list{scrollbar-width:thin;scrollbar-color:#c9973c rgba(0,0,0,.35)}
.rs-rp .rs-modal-text{text-align:center;margin:2px 0 10px}
.rs-rp-list{max-height:min(52vh,420px);overflow-y:auto;padding:0 4px;display:flex;flex-direction:column;gap:6px}
