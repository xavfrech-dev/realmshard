import{Q as S,C as i,V as I,M as o}from"./content-hWZCX_eh.js";const D=[{id:"openSid",foe:{bonusMana:1},name:{fr:"Les Síd ouverts",en:"The Open Síd",de:"Die offenen Síd"},text:{fr:"Les monstres commencent avec 1 cristal de mana de plus.",en:"Monsters start with 1 extra Mana Crystal.",de:"Monster beginnen mit 1 zusätzlichen Manakristall."},lore:{fr:"Echtra Nerai : la nuit de Samhain, les síd s’ouvrent et les morts en sortent.",en:"Echtra Nerai: on Samhain night the síd mounds open and the dead come out.",de:"Echtra Nerai: In der Samhain-Nacht öffnen sich die Síd, und die Toten kommen heraus."}},{id:"hjadningavig",foe:{regen:3},name:{fr:"Le Hjaðningavíg",en:"The Hjaðningavíg",de:"Das Hjaðningavíg"},text:{fr:"Les monstres rendent 3 PV à leur héros tous les trois tours.",en:"Monsters restore 3 Health to their hero every third turn.",de:"Monster heilen ihren Helden jeden dritten Zug um 3."},lore:{fr:"Skáldskaparmál : chaque nuit, Hildr relève les morts, et la bataille reprend à l’aube.",en:"Skáldskaparmál: every night Hildr raises the dead, and the battle resumes at dawn.",de:"Skáldskaparmál: Jede Nacht erweckt Hildr die Toten, und im Morgengrauen beginnt die Schlacht von Neuem."}},{id:"helRoad",foe:{statuses:{thorns:1}},name:{fr:"Le Chemin de Hel",en:"The Hel-Road",de:"Der Helweg"},text:{fr:"Les monstres ont Épines 1.",en:"Monsters have Thorns 1.",de:"Monster haben Dornen 1."},lore:{fr:"Le chemin des morts vers Hel est semé d’épines : on chaussait les défunts pour le marcher.",en:"The road of the dead to Hel is sown with thorns: the dead were given shoes to walk it.",de:"Der Weg der Toten zu Hel ist voller Dornen: Man gab den Verstorbenen Schuhe für ihn mit."}},{id:"machaCurse",hero:{openingMana:-1},name:{fr:"La Malédiction de Macha",en:"Macha’s Curse",de:"Der Fluch der Macha"},text:{fr:"Ton héros a 1 mana de moins à son premier tour.",en:"Your hero has 1 less Mana on their first turn.",de:"Euer Held hat in seinem ersten Zug 1 Mana weniger."},lore:{fr:"Macha maudit les hommes d’Ulster : à l’heure du danger, ils seraient faibles comme une femme en couches.",en:"Macha cursed the men of Ulster: in their hour of need they would be weak as a woman in labour.",de:"Macha verfluchte die Männer von Ulster: In der Stunde der Not sollten sie schwach sein wie eine Frau in den Wehen."}},{id:"wasteLand",altarMul:.5,name:{fr:"La Terre Gaste",en:"The Waste Land",de:"Das Wüste Land"},text:{fr:"Les autels soignent moitié moins.",en:"Altars heal half as much.",de:"Altäre heilen nur halb so viel."},lore:{fr:"Le royaume du Roi blessé ne guérit plus : la terre ne donne rien tant que la question n’est pas posée.",en:"The Wounded King’s realm no longer heals: the land yields nothing until the question is asked.",de:"Das Reich des verwundeten Königs heilt nicht mehr: Das Land gibt nichts, bis die Frage gestellt ist."}},{id:"shieldRoof",foe:{openingArmor:3},name:{fr:"Le Toit de boucliers",en:"The Shield-Roof",de:"Das Schilddach"},text:{fr:"Les monstres commencent avec 3 d’armure de plus.",en:"Monsters start with 3 extra Armor.",de:"Monster beginnen mit 3 zusätzlicher Rüstung."},lore:{fr:"Grímnismál : Valhöll est couverte de boucliers, et ses chevrons sont des lances.",en:"Grímnismál: Valhöll is roofed with shields, and its rafters are spears.",de:"Grímnismál: Valhöll ist mit Schilden gedeckt, und seine Sparren sind Speere."}},{id:"bricriuFeast",foe:{statuses:{strength:1}},name:{fr:"Le Festin de Bricriu",en:"Bricriu’s Feast",de:"Bricrius Fest"},text:{fr:"Les monstres ont Force 1.",en:"Monsters have Strength 1.",de:"Monster haben Stärke 1."},lore:{fr:"Bricriu promit la part du champion à trois héros à la fois, et la salle entière se battit.",en:"Bricriu promised the champion’s portion to three heroes at once, and the whole hall fought.",de:"Bricriu versprach drei Helden zugleich das Heldenstück, und die ganze Halle kämpfte."}},{id:"rhiannonBirds",foe:{openingDraw:1},name:{fr:"Les Oiseaux de Rhiannon",en:"The Birds of Rhiannon",de:"Die Vögel der Rhiannon"},text:{fr:"Les monstres piochent 1 carte de plus au début du combat.",en:"Monsters draw 1 extra card at the start of the fight.",de:"Monster ziehen zu Beginn des Kampfes 1 Karte mehr."},lore:{fr:"Culhwch ac Olwen : les oiseaux de Rhiannon réveillent les morts et endorment les vivants.",en:"Culhwch and Olwen: the birds of Rhiannon wake the dead and lull the living to sleep.",de:"Culhwch und Olwen: Die Vögel der Rhiannon wecken die Toten und schläfern die Lebenden ein."}}],B={bandage:{fr:"Bandage de lin",en:"Linen Bandage",de:"Leinenverband"},spring:{fr:"Eau de la source",en:"Spring Water",de:"Quellwasser"},ward:{fr:"Fiole de garde",en:"Ward Vial",de:"Schutzphiole"},insight:{fr:"Fiole de clairvoyance",en:"Vial of Insight",de:"Phiole der Einsicht"},incense:{fr:"Encens d’os",en:"Bone Incense",de:"Knochenweihrauch"}},E={albion:{name:"Gwair",realm:"albion",lore:{fr:"Preiddeu Annwfn : le captif de Caer Siddi, enchaîné en Annwn. Il en connaît chaque porte.",en:"Preiddeu Annwfn: the captive of Caer Siddi, chained in Annwn. He knows every one of its doors.",de:"Preiddeu Annwfn: Der Gefangene von Caer Siddi, in Annwn angekettet. Er kennt jede seiner Türen."},lines:{welcome:{fr:"J’ai porté la chaîne de Caer Siddi. Je sais ce qui dort sous Camelot.",en:"I wore the chain of Caer Siddi. I know what sleeps under Camelot.",de:"Ich trug die Kette von Caer Siddi. Ich weiß, was unter Camelot schläft."},descend:{fr:"Ce que tu trouves en bas n’est à toi qu’une fois remonté.",en:"What you find down there is yours only once you climb out.",de:"Was Ihr dort unten findet, gehört Euch erst, wenn Ihr wieder oben seid."},escaped:{fr:"Tu es revenu. Peu reviennent avec autant.",en:"You came back. Few come back with so much.",de:"Ihr seid zurück. Wenige kehren mit so viel zurück."},pledgeBack:{fr:"Je suis allé chercher ce que tu m’avais confié. Le reste, Annwn le garde.",en:"I went down for what you entrusted to me. The rest, Annwn keeps.",de:"Ich holte, was Ihr mir anvertraut hattet. Den Rest behält Annwn."},death:{fr:"Les Cryptes t’ont pris. Elles prennent tout le monde, un jour.",en:"The Crypts took you. They take everyone, one day.",de:"Die Krypten haben Euch genommen. Eines Tages nehmen sie jeden."},cache:{fr:"Ce que Gwair cache, Annwn ne le prend pas.",en:"What Gwair hides, Annwn does not take.",de:"Was Gwair verbirgt, nimmt Annwn nicht."}}},midgard:{name:"Hermóðr",realm:"midgard",lore:{fr:"Gylfaginning 49 : il chevaucha neuf nuits jusqu’à Hel pour Baldr, et en rapporta l’anneau Draupnir.",en:"Gylfaginning 49: he rode nine nights to Hel for Baldr, and brought back the ring Draupnir.",de:"Gylfaginning 49: Er ritt neun Nächte zu Hel, um Baldr zu holen, und brachte den Ring Draupnir zurück."},lines:{welcome:{fr:"J’ai passé la grille de Hel et je suis revenu. Toi aussi, peut-être.",en:"I passed Hel’s gate and came back. Perhaps you will too.",de:"Ich kam durch Hels Gatter und kehrte zurück. Vielleicht Ihr auch."},descend:{fr:"Neuf nuits de route. Tu n’en auras pas besoin d’autant pour mourir.",en:"Nine nights’ ride. You will not need that many to die.",de:"Neun Nächte Ritt. Zum Sterben braucht Ihr nicht so viele."},escaped:{fr:"Remonté, et les mains pleines. Odin serait content.",en:"Climbed out, and with full hands. Odin would be pleased.",de:"Wieder oben, und mit vollen Händen. Odin wäre zufrieden."},pledgeBack:{fr:"Ce que Hermóðr porte sur Sleipnir revient de Hel. Rien d’autre.",en:"What Hermod carries on Sleipnir comes back from Hel. Nothing else.",de:"Was Hermóðr auf Sleipnir trägt, kehrt von Hel zurück. Sonst nichts."},death:{fr:"Hel a gardé Baldr. Elle te gardera aussi, un temps.",en:"Hel kept Baldr. She will keep you too, for a while.",de:"Hel behielt Baldr. Sie wird auch Euch behalten, eine Weile."},cache:{fr:"Ce que Hermóðr porte sur Sleipnir revient de Hel.",en:"What Hermod carries on Sleipnir comes back from Hel.",de:"Was Hermóðr auf Sleipnir trägt, kehrt von Hel zurück."}}},hibernia:{name:"Nera",realm:"hibernia",lore:{fr:"Echtra Nerai : la nuit de Samhain, il entra dans le síd de Cruachan et en ressortit avec des fruits de l’été.",en:"Echtra Nerai: on Samhain night he entered the síd of Cruachan and came out with summer fruit.",de:"Echtra Nerai: In der Samhain-Nacht betrat er den Síd von Cruachan und kam mit Sommerfrüchten heraus."},lines:{welcome:{fr:"Je suis entré dans le síd une nuit de Samhain. J’en suis sorti. Écoute-moi.",en:"I went into the síd one Samhain night. I came out. Listen to me.",de:"Ich betrat den Síd in einer Samhain-Nacht. Ich kam heraus. Hört mir zu."},descend:{fr:"En bas, le temps ne compte pas. Ton sang, si.",en:"Down there, time does not count. Your blood does.",de:"Dort unten zählt die Zeit nicht. Euer Blut schon."},escaped:{fr:"Des fruits de l’été en plein hiver. Tu as la preuve que tu es descendu.",en:"Summer fruit in deep winter. You have proof that you went down.",de:"Sommerfrüchte mitten im Winter. Ihr habt den Beweis, dass Ihr unten wart."},pledgeBack:{fr:"Ce que Nera rapporte du síd, nul ne le lui reprend.",en:"What Nera brings back from the síd, no one takes from him.",de:"Was Nera aus dem Síd zurückbringt, nimmt ihm niemand."},death:{fr:"Le síd s’est refermé sur toi. Il se rouvrira à Samhain.",en:"The síd closed on you. It will open again at Samhain.",de:"Der Síd hat sich hinter Euch geschlossen. An Samhain öffnet er sich wieder."},cache:{fr:"Ce que Nera rapporte du síd, nul ne le lui reprend.",en:"What Nera brings back from the síd, no one takes from him.",de:"Was Nera aus dem Síd zurückbringt, nimmt ihm niemand."}}}},T=[{fr:"Descends avec un deck et le stuff que tu portes. Chaque étage cache du butin, et des morts qui le gardent.",en:"Go down with a deck and the gear you wear. Every floor hides loot, and the dead who guard it.",de:"Steigt mit einem Deck und der Ausrüstung hinab, die Ihr tragt. Jede Ebene verbirgt Beute und die Toten, die sie bewachen."},{fr:"Chaque étage a sa Remontée. Remonte quand tu veux : tout ce que tu portes rentre au château.",en:"Every floor has its Way Up. Climb out whenever you like: everything you carry comes home to the castle.",de:"Jede Ebene hat ihren Aufstieg. Steigt auf, wann Ihr wollt: Alles, was Ihr tragt, kommt in die Burg."},{fr:"Si tu tombes, tu perds ton sac et le stuff que tu portes. Tes cartes, jamais.",en:"If you fall, you lose your satchel and the gear you wear. Never your cards.",de:"Fallt Ihr, verliert Ihr Euren Ranzen und die Ausrüstung, die Ihr tragt. Eure Karten nie."},{fr:"Gage une pièce chez moi : si tu tombes, j’irai la chercher en bas.",en:"Pledge a piece with me: if you fall, I will go down and fetch it.",de:"Verpfändet mir ein Teil: Fallt Ihr, hole ich es von unten zurück."}],M={firstFind:{fr:"Rien n’est à toi tant que tu n’es pas remonté.",en:"Nothing is yours until you climb out.",de:"Nichts gehört Euch, bis Ihr wieder oben seid."},firstWayUp:{fr:"La Remontée : d’ici, tu rentres au château avec tout ton sac.",en:"The Way Up: from here you go home to the castle with your whole satchel.",de:"Der Aufstieg: Von hier kehrt Ihr mit Eurem ganzen Ranzen in die Burg zurück."},firstPit:{fr:"Chaque serviteur mort jette un Ossement dans la Fosse. Certaines cartes s’en nourrissent.",en:"Every minion that dies adds a Bone to the Pit. Some cards feed on them.",de:"Jeder sterbende Diener legt ein Gebein in die Grube. Manche Karten nähren sich davon."},satchelFull:{fr:"Sac plein : jette un objet, ou laisse celui-ci.",en:"Satchel full: drop something, or leave this one.",de:"Ranzen voll: Werft etwas weg oder lasst dies hier liegen."},lowHp:{fr:"Une fiole, ou la Remontée ?",en:"A vial, or the Way Up?",de:"Eine Phiole oder der Aufstieg?"}},z={fr:"Je connais",en:"I know",de:"Kenne ich"},f="pNInz6obpgDQGcFmaJgB",C="Xb7hH8MSUJpSbSDYk0k2",L="pqHfZKP75CvOlQylNhV4",t="nPczCjzI2devNBz1zQrb",g="N2lVS1w4EtoT3dr4eOWO",l="IKne3meq5aSn9XLyUdCD",p="iP95p4xoKVk53GoZ742B",h="onwK4e9ZLuTAKqWW03F9",u="cjVigY5qzO86Huf0OWal",w="JBFqnCBsd6RMkjVDRZzb",b="SOYHLrjzK2X1ezoPC6cr",c="pFZP5JQG7iQjIQuC4Bku",N="XrExE9yKIg1WjnnlVkGX",m="CwhRBWXzGAHq8TQ4Fs17",v="bIHbv24MWmeRgasZH58o",e=(n,r,a)=>({fr:r,en:n,de:a}),s=n=>I[n].line,W={simeon:{voice:w,rate:.82,lines:{intro:s("simeon"),phase2:e("The flames rise. Burn with me.","Les flammes montent. Brûle avec moi.","Die Flammen steigen. Brennt mit mir."),taunt:e("Centuries in this fire. You will not last the night.","Des siècles dans ce feu. Tu ne tiendras pas la nuit.","Jahrhunderte in diesem Feuer. Ihr übersteht die Nacht nicht."),lowHp:e("Is it you, then? You, who come to quench me?","C’est donc toi ? Toi qui viens m’éteindre ?","Seid Ihr es also? Ihr, der mich löschen kommt?"),victory:e("Not the chosen one. Only ash.","Pas l’élu. Rien que de la cendre.","Nicht der Erwählte. Nur Asche."),defeat:e("At last... the fire goes out.","Enfin… le feu s’éteint.","Endlich … das Feuer erlischt.")}},hellawes:{voice:c,rate:.9,lines:{intro:s("hellawes"),phase2:e("Wake, my chapel. Keep this one for me.","Éveille-toi, ma chapelle. Garde-le-moi.","Erwache, meine Kapelle. Halte ihn mir fest."),taunt:e("Lancelot refused me. I died of it. You will not be so lucky.","Lancelot m’a refusée. J’en suis morte. Tu n’auras pas cette chance.","Lancelot wies mich ab. Ich starb daran. Dieses Glück habt Ihr nicht."),lowHp:e("Do not leave me. Not like he did.","Ne me quitte pas. Pas comme lui.","Verlasst mich nicht. Nicht wie er."),victory:e("Now you are mine. Embalmed, and mine.","Te voilà à moi. Embaumé, et à moi.","Nun gehört Ihr mir. Einbalsamiert, und mein."),defeat:e("Refused... again.","Refusée… encore.","Abgewiesen … schon wieder.")}},angantyr:{voice:l,rate:.8,lines:{intro:s("angantyr"),phase2:e("Tyrfing leaves the barrow. Someone must die for it.","Tyrfing sort du tertre. Il faut que quelqu’un en meure.","Tyrfing verlässt den Hügel. Jemand muss dafür sterben."),rise:e("The dead of Samsø do not stay down.","Les morts de Samsø ne restent pas couchés.","Die Toten von Samsø bleiben nicht liegen."),lowHp:e("My eleven brothers sleep. Do not send me to join them.","Mes onze frères dorment. Ne m’envoie pas les rejoindre.","Meine elf Brüder schlafen. Schickt mich nicht zu ihnen."),victory:e("Another mound on Samsø. Another fire.","Un tertre de plus sur Samsø. Un feu de plus.","Ein Hügel mehr auf Samsø. Ein Feuer mehr."),defeat:e("Take the sword, then. It will be the death of your kin.","Prends l’épée, alors. Elle sera la mort des tiens.","Nehmt das Schwert also. Es wird der Tod Eurer Sippe sein.")}},abhartach:{voice:u,rate:.84,lines:{intro:s("abhartach"),rise:e("Bury me as you like. I come back.","Enterre-moi comme tu voudras. Je reviens.","Begrabt mich, wie Ihr wollt. Ich kehre zurück."),rise2:e("Again. Bring me my cup.","Encore. Apportez-moi ma coupe.","Noch einmal. Bringt mir meinen Becher."),lowHp:e("Thirsty. Always so thirsty.","Soif. Toujours si soif.","Durst. Immer dieser Durst."),victory:e("Your blood will do. For tonight.","Ton sang fera l’affaire. Pour ce soir.","Euer Blut genügt. Für heute Nacht."),defeat:e("Head down... and a stone on top. Clever.","La tête en bas… et une pierre dessus. Bien joué.","Kopf nach unten … und ein Stein darauf. Klug.")}},ankou:{voice:t,rate:.74,lines:{intro:s("ankou"),phase2:e("My scythe is sharp. The knell is ringing.","Ma faux est affûtée. Le glas sonne.","Meine Sense ist scharf. Die Totenglocke läutet."),rise:e("Death does not die.","La mort ne meurt pas.","Der Tod stirbt nicht."),lowHp:e("Run, if you like. The cart is slow, but it always arrives.","Cours, si tu veux. La charrette est lente, mais elle arrive toujours.","Lauft, wenn Ihr wollt. Der Karren ist langsam, aber er kommt immer an."),victory:e("Climb onto the cart.","Monte dans la charrette.","Steigt auf den Karren."),defeat:e("Another will drive the cart this year. Not for long.","Un autre mènera la charrette cette année. Pas longtemps.","Ein anderer lenkt den Karren dieses Jahr. Nicht lange.")}}},q={[o.simeon.fr]:"phase2",[o.hellawes.fr]:"phase2",[o.angantyrSword.fr]:"phase2",[o.ankouScythe.fr]:"phase2"},P={valKnight:{voice:p,rate:.9},thirtyInBlack:{voice:f,rate:.85},hjorvardr:{voice:b,rate:.88},glamr:{voice:g,rate:.8},loegaire:{voice:h,rate:.85}},j=(n,r)=>`crypts_boss_${n}_${r}`,O=n=>`crypts_elite_${n}`,G={albion:{voice:L,rate:.95},midgard:{voice:m,rate:.95},hibernia:{voice:v,rate:1}};function K(n,r){return r.startsWith("tut")?T[Number(r.slice(3))]:E[n].lines[r]}const F=(n,r)=>`crypts_warden_${n}_${r}`,H={"crypts.hellawes":["Come closer, knight. One kiss for the road.","Approche, chevalier. Un baiser pour la route.","Kommt näher, Ritter. Ein Kuss für den Weg.",c,.92],"crypts.angantyr":["Who wakes the dead of Samsø?","Qui réveille les morts de Samsø ?","Wer weckt die Toten von Samsø?",l,.8],"crypts.abhartach":["Kill me once. Kill me twice. I still come back.","Tue-moi une fois. Tue-moi deux fois. Je reviens encore.","Tötet mich einmal. Tötet mich zweimal. Ich kehre immer wieder.",u,.84],"crypts.ankou":["Everyone onto the cart.","Tout le monde dans la charrette.","Alle auf den Karren.",t,.74],[i.hellawesDesire]:["I will keep your body, Lancelot, if not your heart.","Je garderai ton corps, Lancelot, à défaut de ton cœur.","Ich behalte Euren Leib, Lancelot, wenn schon nicht Euer Herz.",c,.9],[i.barrowOpens]:["Rise, brothers. The barrow is open.","Debout, mes frères. Le tertre est ouvert.","Erhebt euch, Brüder. Der Hügel ist offen.",l,.8],[i.clanBlood]:["Bleed for your king.","Saignez pour votre roi.","Blutet für euren König.",u,.84],[i.killYouAll]:["I kill you all.","Je vous tue tous.","Ich töte euch alle.",t,.74],[i.knellScythe]:["The knell rings for you.","Le glas sonne pour toi.","Die Totenglocke läutet für Euch.",t,.74],"reaver.gwythyr":["Every May Day I fight for her. Today, I fight you.","Chaque premier mai, je me bats pour elle. Aujourd’hui, contre toi.","Jeden ersten Mai kämpfe ich um sie. Heute gegen Euch.",m],"reaver.mabon":["They took me at three nights old. I have hunted ever since.","On m’a pris à trois nuits. Je chasse depuis.","Drei Nächte alt nahm man mich. Seitdem jage ich.",v],"reaver.llwchLleawg":["My sword lights the dark of Annwn.","Mon épée éclaire la nuit d’Annwn.","Mein Schwert erhellt das Dunkel von Annwn.",f],"warlock.svipdagr":["Mother, sing me the charms again.","Mère, chante-moi encore les charmes.","Mutter, sing mir die Zauber noch einmal.",p],"warlock.hyndla":["Who wakes me? I know your whole lineage. The dead first.","Qui me réveille ? Je connais toute ta lignée. Les morts d’abord.","Wer weckt mich? Ich kenne Euer ganzes Geschlecht. Die Toten zuerst.",C,.85],"warlock.bolverk":["I stole the mead. I kept the song.","J’ai volé l’hydromel. J’ai gardé le chant.","Ich stahl den Met. Ich behielt das Lied.",w,.9],"warlock.hangatyr":["Nine nights on the tree. Now, everyone falls.","Neuf nuits à l’arbre. Maintenant, tout le monde tombe.","Neun Nächte am Baum. Jetzt fallen alle.",h,.8],"bainshee.donnFirinne":["The storms are my horses. Hear them come.","Les tempêtes sont mes chevaux. Écoute-les venir.","Die Stürme sind meine Pferde. Hört sie kommen.",g,.85],"bainshee.conaire":["Every geis broken. Bring me water.","Toutes mes geasa brisées. Apportez-moi de l’eau.","Jedes Geis gebrochen. Bringt mir Wasser.",m,.95],"bainshee.brian":["For Ireland, one last time.","Pour l’Irlande, une dernière fois.","Für Irland, ein letztes Mal.",b],"bainshee.fionnbharr":["Saddle the grey horses. We ride over the harvest.","Sellez les chevaux gris. Nous chevauchons sur la moisson.","Sattelt die grauen Pferde. Wir reiten über die Ernte.",t,.9]},A={"lune.reaver.arawn":[t,.82],"lune.warlock.eighteenCharms":[h],"lune.bainshee.cliodhna":[N]},J={...Object.fromEntries(Object.entries(H).map(([n,[r,a,d,y,k]])=>[n,{en:r,fr:a,de:d,voice:y,rate:k??1}])),...Object.fromEntries(Object.entries(S).map(([n,r])=>{const[a,d]=A[n]??[h];return[n,{en:r.en,fr:r.fr,de:r.de,voice:a,rate:d??1}]}))},_=[e("Under Camelot, under every keep, the old dead are not asleep.","Sous Camelot, sous chaque forteresse, les vieux morts ne dorment pas.","Unter Camelot, unter jeder Burg, schlafen die alten Toten nicht."),e("The Crypts open beneath the castle courtyard. Every floor goes deeper, and every floor has its Way Up.","Les Cryptes s’ouvrent sous la cour du château. Chaque étage descend plus bas, et chaque étage a sa Remontée.","Die Krypten öffnen sich unter dem Burghof. Jede Ebene führt tiefer, und jede hat ihren Aufstieg."),e("Three wardens came back from the dead to keep the doors: Gwair, Hermod and Nera.","Trois gardiens sont revenus des morts pour garder les portes : Gwair, Hermóðr et Nera.","Drei Wächter kehrten von den Toten zurück, um die Tore zu hüten: Gwair, Hermóðr und Nera."),e("Every death down there feeds the Pit. And the Pit remembers every bone.","Chaque mort, en bas, nourrit la Fosse. Et la Fosse se souvient de chaque os.","Jeder Tod dort unten nährt die Grube. Und die Grube erinnert sich an jeden Knochen."),e("Other raiders went down before you. Their ghosts are still hunting.","D’autres pillards sont descendus avant toi. Leurs fantômes chassent encore.","Andere Plünderer stiegen vor Euch hinab. Ihre Phantome jagen noch immer."),e("What you find is yours only once you climb out. Fall, and the Crypts keep it.","Ce que tu trouves n’est à toi qu’une fois remonté. Tombe, et les Cryptes le gardent.","Was Ihr findet, gehört Euch erst, wenn Ihr wieder oben seid. Fallt Ihr, behalten es die Krypten."),e("And at the very bottom, the cart creaks. The Ankou is waiting.","Et tout au fond, la charrette grince. L’Ankou attend.","Und ganz unten knarrt der Karren. Der Ankou wartet.")];export{W as C,T,B as V,_ as a,D as b,P as c,J as d,q as e,E as f,G as g,z as h,M as i,j,O as k,K as l,F as m};
