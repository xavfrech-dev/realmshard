  border-style:solid;border-width:var(--b);border-image:${e("kit.panel")} 88 fill / var(--b) stretch;
  image-rendering:pixelated;filter:drop-shadow(0 14px 28px rgba(0,0,0,.7))}
.rs-modal-panel>*{position:relative}
.rs-modal-ribbon{position:absolute;left:50%;top:calc(-1 * var(--b) - 28px);transform:translateX(-50%);min-width:min(380px,calc(100vw - 40px));height:62px;
  padding:0 74px 8px;display:flex;align-items:center;justify-content:center;white-space:nowrap;
  border-style:solid;border-width:0 74px;border-image:${e("kit.ribbon")} 0 150 fill / 0 74px stretch;image-rendering:pixelated;
  font-family:"Almendra",Georgia,serif;font-weight:700;font-size:23px;letter-spacing:.5px;color:#ffe6a8;
  text-shadow:0 2px 0 #1a0c04,0 0 2px #1a0c04,1px 0 0 #1a0c04,-1px 0 0 #1a0c04,0 -1px 0 #1a0c04,0 0 12px rgba(255,170,60,.35)}
.rs-modal-text{margin:4px 0 16px;font-size:15px;line-height:1.4;color:#e4d6b4;text-shadow:0 1px 0 #000}
.rs-modal-input{display:block;width:100%;height:50px;padding:0 22px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:22px;
  text-align:center;color:#ffe6a8;caret-color:#ffd070;background:transparent;outline:none;
  border-style:solid;border-width:12px 26px;border-image:${e("kit.well")} 22 50 fill / 12px 26px stretch;image-rendering:pixelated;
  text-shadow:0 2px 0 #000}
.rs-modal-input:focus{filter:brightness(1.15) drop-shadow(0 0 6px rgba(255,190,90,.55))}
.rs-modal-input::selection{background:#8a5a1c;color:#fff4dc}
.rs-modal-err{min-height:20px;margin:6px 0 8px;font-size:13px;color:#ff9a8a;text-shadow:0 1px 0 #000}
.rs-modal-row{display:flex;gap:12px;justify-content:center}
.rs-modal-btn{flex:1;max-width:220px;height:48px;padding:0 6px;cursor:pointer;background:transparent;
  border-style:solid;border-width:15px 28px;border-image:${e("kit.buttonStone")} 30 56 fill / 15px 28px stretch;image-rendering:pixelated;
  font-family:"Almendra",Georgia,serif;font-weight:700;font-size:17px;line-height:1;color:#fff4dc;white-space:nowrap;
  text-shadow:0 2px 0 #0c0806,0 0 2px #0c0806,1px 0 0 #0c0806,-1px 0 0 #0c0806;transition:filter .12s,transform .08s}
.rs-modal-btn--ok{border-image-source:${e("kit.buttonGreen")}}
.rs-modal-btn:hover:not(:disabled){filter:brightness(1.22) drop-shadow(0 0 8px rgba(255,180,80,.5))}
.rs-modal-btn:active:not(:disabled){transform:scale(.96)}
.rs-modal-btn:disabled{cursor:default;filter:grayscale(.75) brightness(.6)}
.rs-modal-btn:focus-visible{outline:2px solid #ffd070;outline-offset:2px}
@media (max-height:460px){
  .rs-modal{padding-top:30px}
  .rs-modal-panel{--b:26px;padding:12px 4px 0}
  .rs-modal-ribbon{height:46px;font-size:19px;padding-bottom:6px;border-width:0 56px;border-image-width:0 56px}
  .rs-modal-text{font-size:14px;margin:2px 0 10px;line-height:1.3}
  .rs-modal-input{height:42px;font-size:19px}
  .rs-modal-err{min-height:16px;margin:4px 0 6px;font-size:14px}
  .rs-modal-btn{height:44px;font-size:15px;border-width:12px 22px;border-image-width:12px 22px}
}
.rs-modal.rs-kb,.rs-modal.rs-tall{align-items:flex-start;overflow-y:auto;padding-top:34px}
.rs-modal.rs-kb .rs-modal-panel,.rs-modal.rs-tall .rs-modal-panel{margin:0 auto 12px}
