.rs-inst-head{display:flex;align-items:center;gap:14px;margin:6px 4px 10px;text-align:left}
.rs-inst-icon{width:68px;height:68px;flex:none;border-radius:16px;image-rendering:pixelated;
  box-shadow:0 0 0 2px #1a0c04,0 0 0 4px #c89a48,0 6px 14px rgba(0,0,0,.6)}
.rs-inst-q{font-family:"Almendra",Georgia,serif;font-weight:700;font-size:21px;line-height:1.15;color:#ffe6a8;text-shadow:0 2px 0 #1a0c04}
.rs-inst-list{list-style:none;margin:0 6px 14px;padding:0;text-align:left;font-size:15px;color:#e4d6b4;text-shadow:0 1px 0 #000}
.rs-inst-list li{display:flex;align-items:center;gap:8px;padding:3px 0}
.rs-inst-list li::before{content:"✦";color:#ffc860;font-size:13px;text-shadow:0 0 6px rgba(255,180,70,.6)}
.rs-inst-how{margin:0 4px 14px;padding:10px 12px;text-align:left;font-size:14px;line-height:1.4;color:#efe2c2;
  background:rgba(10,6,3,.55);border:1px solid #6a4a22;border-radius:8px;text-shadow:0 1px 0 #000}
.rs-inst-how[hidden]{display:none}
.rs-inst-note{margin:-6px 6px 12px;text-align:left;font-size:13px;line-height:1.35;color:#ffd27a;text-shadow:0 1px 0 #000}
.rs-inst-steps{display:flex;flex-direction:column;gap:8px;margin-top:6px}
.rs-inst-step{display:flex;align-items:center;gap:10px}
.rs-inst-num{width:22px;height:22px;flex:none;border-radius:50%;background:#8a5a1c;color:#fff4dc;font-weight:700;font-size:13px;
  display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 1px #1a0c04}
.rs-inst-glyph{width:34px;height:34px;flex:none;border-radius:8px;background:#f4f4f6;display:flex;align-items:center;justify-content:center}
.rs-inst-glyph svg{width:22px;height:22px}
.rs-inst-pill{flex:none;padding:5px 10px;border-radius:8px;background:#f4f4f6;color:#0a63d8;font:600 14px -apple-system,"Segoe UI",sans-serif}
.rs-inst-ok{color:#9be59b}
.rs-inst-never{display:block;margin:10px auto 4px;padding:4px 8px;background:none;border:none;cursor:pointer;
  font-family:"Alegreya",Georgia,serif;font-size:13px;color:#b8a580;text-decoration:underline;text-underline-offset:3px}
.rs-inst-never:hover,.rs-inst-never:focus-visible{color:#ffe6a8;outline:none}
.rs-inst--compact .rs-modal-panel{width:min(380px,calc(100vw - 32px))}
.rs-inst--compact .rs-inst-icon{width:48px;height:48px;border-radius:12px}
.rs-inst--compact .rs-inst-q{font-size:18px}
.rs-inst--compact .rs-inst-list{font-size:14px}
@media (max-height:460px){
  .rs-inst-head{margin:2px 4px 6px}.rs-inst-icon{width:46px;height:46px;border-radius:11px}.rs-inst-q{font-size:18px}
  .rs-inst-list{font-size:13px;margin-bottom:8px}.rs-inst-list li{padding:1px 0}
  .rs-inst-how{font-size:13px;margin-bottom:8px;padding:6px 10px}.rs-inst-steps{gap:4px}
  .rs-inst-glyph{width:28px;height:28px}.rs-inst-never{margin:4px auto 2px}.rs-inst-note{font-size:12px;margin:-4px 6px 8px}
}
