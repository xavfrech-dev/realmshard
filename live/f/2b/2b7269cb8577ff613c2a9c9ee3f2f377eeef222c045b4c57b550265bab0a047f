.rs-bug .rs-modal-panel{width:min(580px,calc(100vw - 32px));text-align:left}
.rs-bug-body{max-height:calc(100vh - 150px);overflow-y:auto;padding:0 6px}
.rs-bug .rs-modal-text{text-align:center;margin:2px 0 10px}
.rs-bug-cats{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin:0 0 10px}
.rs-bug-cat{min-width:84px;height:32px;padding:0 10px;cursor:pointer;border-radius:4px;border:2px solid #5a4028;
  background:linear-gradient(#3a2c1e,#1c140c);color:#e4d6b4;font:700 14px "Almendra",Georgia,serif;text-shadow:0 1px 0 #000}
.rs-bug-cat[aria-pressed="true"]{border-color:#e4c16a;background:linear-gradient(#8a2a30,#4a1016);color:#fff4dc;box-shadow:0 0 8px rgba(255,190,90,.45)}
.rs-bug-cat:focus-visible{outline:2px solid #ffd070;outline-offset:2px}
.rs-bug-text{display:block;width:100%;height:132px;resize:none;padding:8px 10px;border-radius:4px;border:2px solid #8a5a1c;
  background:rgba(12,6,2,.78);color:#f2e6c8;caret-color:#ffd070;font:15px/1.35 "Alegreya",Georgia,serif;outline:none;
  box-shadow:inset 0 2px 6px rgba(0,0,0,.7)}
.rs-bug-text:focus{border-color:#e4c16a;box-shadow:inset 0 2px 6px rgba(0,0,0,.7),0 0 6px rgba(255,190,90,.45)}
.rs-bug-text::placeholder{color:#8f7f62}
.rs-bug-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:6px 0 2px;font-size:14px;color:#e4d6b4}
.rs-bug-shot{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.rs-bug-shot input{width:18px;height:18px;accent-color:#c8a040;cursor:pointer}
.rs-bug-shot img{height:30px;border:1px solid #8a5a1c;border-radius:2px}
.rs-bug-count{font-variant-numeric:tabular-nums;color:#cdbb94}
.rs-bug-noshot{font-size:12px;line-height:1.3;color:#a89878}
.rs-bug-count.bad{color:#ff9a8a}
.rs-bug-privacy{margin:4px 0 0;font-size:14px;line-height:1.3;color:#a89878;text-align:center}
.rs-bug .rs-modal-err{text-align:center}
@media (max-height:460px){
  .rs-bug-body{max-height:calc(100vh - 120px)}
  .rs-bug .rs-modal-text{display:none}
  .rs-bug-cats{gap:4px;margin-bottom:6px}
  .rs-bug-cat{min-width:0;height:28px;font-size:13px;padding:0 8px}
  .rs-bug-text{height:78px;font-size:14px}
  .rs-bug-meta{font-size:13px;margin-top:4px}
}
