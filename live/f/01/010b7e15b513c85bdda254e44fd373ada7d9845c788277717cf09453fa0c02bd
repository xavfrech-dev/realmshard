.rs-auth{background:radial-gradient(ellipse at 50% 35%,rgba(42,22,8,.88),rgba(4,2,1,.97))}
.rs-auth .rs-modal-panel{width:min(500px,calc(100vw - 32px));padding:14px 6px 2px}
.rs-auth-tabs{display:flex;gap:8px;justify-content:center;margin:0 0 6px}
.rs-auth-tabs .rs-modal-btn{max-width:210px;height:44px;font-size:16px}
.rs-auth-tab:not(.rs-modal-btn--ok){filter:grayscale(.5) brightness(.75)}
.rs-auth-body{overflow-y:auto;overflow-x:hidden;padding:2px 8px 0;text-align:left}
.rs-auth-main .rs-auth-actions{margin:4px 0 6px}
.rs-auth-intro{margin:0 0 8px;font-size:14px;line-height:1.35;color:#e4d6b4;text-shadow:0 1px 0 #000;text-align:center}
.rs-auth-notice{margin:0 0 8px;padding:6px 10px;border:1px solid rgba(255,154,138,.5);border-radius:6px;background:rgba(60,10,6,.45);font-size:13px;color:#ffc4b8;text-align:center}
.rs-auth-grid{display:block}
.rs-auth-field{margin:0 0 6px}
.rs-auth-label{display:block;margin:0 0 1px 8px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:14px;color:#ffe6a8;text-shadow:0 1px 0 #000}
.rs-auth-wrap{position:relative}
.rs-auth .rs-modal-input.rs-auth-input{height:44px;padding:0 12px;font-size:17px;text-align:left;border-width:10px 18px;border-image-width:10px 18px}
.rs-auth-input::placeholder{color:rgba(255,230,168,.38);font-weight:400}
.rs-auth-wrap .rs-auth-input{padding-right:62px}
.rs-auth-eye{position:absolute;right:16px;top:50%;transform:translateY(-50%);height:26px;padding:0 8px;cursor:pointer;
  background:rgba(20,10,4,.65);border:1px solid rgba(217,164,65,.55);border-radius:5px;color:#ffe6a8;font:700 12px "Alegreya",Georgia,serif}
.rs-auth-eye:hover{filter:brightness(1.25)}
.rs-auth-status{min-height:17px;margin:1px 8px 0;font-size:13px;line-height:1.3;color:#e4d6b4;text-shadow:0 1px 0 #000}
.rs-auth-status.ok{color:#a8e08a}
.rs-auth-status.bad{color:#ff9a8a}
.rs-auth-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:4px 6px 2px}
.rs-auth-check{display:flex;align-items:center;gap:8px;font-size:14px;color:#f2e6c8;cursor:pointer;user-select:none}
.rs-auth-check input{width:18px;height:18px;accent-color:#c8902c;cursor:pointer}
.rs-auth-link{background:none;border:none;padding:2px 0;color:#ffd070;text-decoration:underline;cursor:pointer;font:600 14px "Alegreya",Georgia,serif;text-shadow:0 1px 0 #000}
.rs-auth-link:hover{color:#fff0c0}
.rs-auth-err{min-height:18px;margin:4px 6px;font-size:13px;line-height:1.3;color:#ff9a8a;text-shadow:0 1px 0 #000;text-align:center}
.rs-auth-err.ok{color:#a8e08a}
.rs-auth-actions{display:flex;flex-direction:column;align-items:center;gap:6px;margin:4px 0 8px}
.rs-auth-actions .rs-modal-btn{width:100%;max-width:300px;flex:none}
.rs-auth-alt{height:38px!important;font-size:14px!important;max-width:320px!important}
.rs-auth-foot{display:flex;justify-content:center;gap:10px;margin:2px 0 8px}
.rs-auth-foot .rs-modal-btn{max-width:240px;height:42px;font-size:15px}
.rs-auth.rs-modal{padding-top:34px}
.rs-auth-captcha{display:flex;flex-direction:column;align-items:center;gap:2px;margin:4px 0 2px;min-height:24px}
.rs-auth-captcha-label{font-size:12px;color:#cdbb94;text-shadow:0 1px 0 #000}
/* The provider's iframe at the page's own scale: WebKit (iPhone) mis-hits and
   fails Turnstile inside a CSS-zoomed panel (.rs-modal-panel zoom). */
.rs-auth-captcha-host{zoom:calc(1 / var(--rs-z, 1));width:100%;max-width:340px;display:flex;justify-content:center}
.rs-auth-captcha-retry{font-size:12px;color:#f2d27a;text-decoration:underline;cursor:pointer;background:none;border:0;padding:2px 6px}
.rs-auth-privacy{margin:2px 6px 4px;font-size:12px;line-height:1.3;color:#cdbb94;text-align:center;text-shadow:0 1px 0 #000}
.rs-auth-privacy .rs-auth-link{font-size:12px}
.rs-auth-pending{margin:0 0 8px;padding:6px 10px;border:1px solid rgba(168,224,138,.45);border-radius:6px;background:rgba(10,30,6,.45);font-size:13px;line-height:1.35;color:#d8f0c8;text-align:center}
.rs-auth-notice{margin:2px 6px 4px;padding:5px 10px;border:1px solid rgba(255,214,120,.5);border-radius:6px;background:rgba(40,26,4,.5);font-size:13px;line-height:1.3;color:#ffe6a8;text-align:center;text-shadow:0 1px 0 #000}
.rs-auth-notice-mail{display:block;margin-top:2px;color:#fff4d0;font-weight:700;overflow-wrap:anywhere}
.rs-auth-pending-row{display:flex;flex-wrap:wrap;gap:6px 14px;justify-content:center;margin-top:4px}
.rs-auth-net{margin:0 8px 6px}
.rs-auth-net .rs-auth-link{margin-left:6px}
.rs-auth-net-msg{margin-top:2px;font-size:12px;color:#e4d6b4}
@media (min-width:640px){
  .rs-auth .rs-modal-panel{width:min(720px,calc(100vw - 32px))}
  .rs-auth-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
}
@media (max-height:520px){
  .rs-auth.rs-modal{padding-top:26px}
  .rs-auth .rs-modal-panel{padding:8px 4px 0}
  .rs-auth-tabs .rs-modal-btn{height:36px;font-size:14px;border-width:11px 22px;border-image-width:11px 22px}
  .rs-auth-intro{font-size:14px;margin:0 0 4px}
  .rs-auth-notice{margin:0 4px 2px;padding:3px 8px;font-size:12px}
  .rs-auth-label{font-size:14px}
  .rs-auth .rs-modal-input.rs-auth-input{height:36px;font-size:15px;border-width:8px 16px;border-image-width:8px 16px}
  .rs-auth-status{min-height:14px;font-size:14px}
  .rs-auth-err{min-height:14px;margin:2px 6px;font-size:14px}
  .rs-auth-field{margin:0 0 2px}
  .rs-auth-actions{margin:2px 0 4px;gap:4px}
  .rs-auth-actions .rs-modal-btn{height:36px;font-size:14px;border-width:11px 22px;border-image-width:11px 22px}
  .rs-auth-foot{margin:0 0 4px}
  /* Short landscape phones (audit 03 §2): « Jouer hors ligne » / « Retour » become a text link under the main button. */
  .rs-auth-foot{margin:0 0 2px}
  .rs-auth-foot .rs-modal-btn{height:26px!important;min-height:0;padding:0 6px;border:none!important;border-image:none!important;background:none!important;box-shadow:none!important;filter:none!important;color:#ffd070;text-decoration:underline;font:600 14px "Alegreya",Georgia,serif;text-shadow:0 1px 0 #000}
  .rs-auth-check,.rs-auth-link,.rs-auth-privacy,.rs-auth-privacy .rs-auth-link,.rs-auth-captcha-label{font-size:14px}
  /* (Short screens zoom the window to 0.8 at most: 14 px stays ≥ 11 px, overflow MEN-29.) */
}
