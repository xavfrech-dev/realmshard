.rs-guide-list{margin:0;padding:0;list-style:none}
.rs-guide-list li{position:relative;margin:0 0 6px;padding-left:18px;font-size:15px;line-height:1.35;color:#ecdfbf;text-shadow:0 1px 0 #000}
