  animation:rs-unlock-item .5s ease-out both}
.rs-unlock-item:nth-child(2){animation-delay:.15s}.rs-unlock-item:nth-child(3){animation-delay:.3s}.rs-unlock-item:nth-child(4){animation-delay:.45s}
.rs-unlock-icon{flex:none;width:52px;height:52px;padding:5px;border-radius:50%;border:2px solid #e2b350;
  background:radial-gradient(circle at 50% 40%,rgba(255,210,120,.45),rgba(20,10,4,.7) 70%);box-shadow:0 0 0 2px #1a0c04,0 0 16px rgba(255,200,90,.6)}
.rs-unlock-icon img{width:100%;height:100%;object-fit:contain;image-rendering:pixelated}
.rs-unlock-name{font-family:"Almendra",Georgia,serif;font-weight:700;font-size:20px;color:#ffe6a8;text-shadow:0 2px 0 #1a0c04}
.rs-unlock-desc{font-size:14px;line-height:1.3;color:#ecdfbf;text-shadow:0 1px 0 #000}
@keyframes rs-unlock-in{0%{transform:scale(.6);opacity:0}100%{transform:scale(1);opacity:1}}
@keyframes rs-unlock-item{0%{transform:translateY(10px);opacity:0;filter:brightness(2)}100%{transform:none;opacity:1;filter:none}}
@media (max-height:460px){.rs-unlock-icon{width:38px;height:38px}.rs-unlock-name{font-size:16px}.rs-unlock-desc{font-size:12px}.rs-unlock-list{gap:4px;margin-bottom:6px}}
