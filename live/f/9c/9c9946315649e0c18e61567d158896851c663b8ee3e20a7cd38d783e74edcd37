.fp-eye{flex:none;width:18px;height:18px;image-rendering:pixelated;filter:drop-shadow(0 0 4px rgba(255,90,70,.6))}
.fp-acts{display:flex;flex-wrap:wrap;gap:5px;padding:2px 6px 8px 26px}
.fp-btn{min-height:34px;padding:0 6px;cursor:pointer;background:transparent;color:#fff4dc;white-space:nowrap;
  border-style:solid;border-width:9px 16px;border-image:${r("kit.buttonStone")} 30 56 fill / 9px 16px stretch;image-rendering:pixelated;
  font-family:var(--rs-font-title);font-weight:700;font-size:14px;line-height:1;text-shadow:var(--rs-stroke);transition:filter .12s,transform .08s}
.fp-btn--ok{border-image-source:${r("kit.buttonGreen")}}
.fp-btn--bad{border-image-source:${r("kit.buttonRed")}}
.fp-btn--flat{filter:brightness(.82)}
.fp-btn:hover:not(:disabled){filter:brightness(1.2) drop-shadow(0 0 6px rgba(255,180,80,.45))}
.fp-btn:active:not(:disabled){transform:scale(.96)}
.fp-btn:disabled{cursor:default;filter:grayscale(.8) brightness(.6)}
.fp-btn:focus-visible{outline:none;filter:brightness(1.15) drop-shadow(0 0 5px #ffd070)}
.fp-card{margin:4px 2px 8px;padding:2px 4px;border-style:solid;border-width:12px 14px;border-image:${r("kit.tooltip")} 40 42 fill / 12px 14px stretch;image-rendering:pixelated}
.fp-card--invite{filter:drop-shadow(0 0 8px rgba(255,190,90,.45))}
.fp-card p{margin:0 0 7px;font-size:14px;line-height:1.3}
.fp-card .fp-line{display:flex;gap:6px;flex-wrap:wrap}
.fp-muted{font-size:14px;line-height:1.4;color:var(--rs-muted);margin:10px 6px;text-shadow:0 1px 0 #000}
.fp-empty{display:flex;flex-direction:column;align-items:center;gap:4px;margin:14px 6px 4px;text-align:center}
.fp-empty img{width:56px;height:56px;filter:drop-shadow(0 3px 4px rgba(0,0,0,.6))}
.fp-empty .fp-muted{margin:4px 2px}
.fp-note{font-size:12px;line-height:1.3;color:var(--rs-dim);margin:4px 6px 0}
.fp-ok{color:var(--rs-ok)}.fp-err{color:var(--rs-bad)}
.fp-input{display:block;width:100%;min-height:42px;padding:0 10px;background:transparent;color:var(--rs-gold-hi);outline:none;caret-color:#ffd070;
  border-style:solid;border-width:9px 18px;border-image:${r("kit.well")} 22 50 fill / 9px 18px stretch;image-rendering:pixelated;
  font-family:var(--rs-font-title);font-weight:700;font-size:17px}
.fp-input::placeholder{color:var(--rs-dim)}
.fp-input:focus{filter:brightness(1.15) drop-shadow(0 0 5px rgba(255,190,90,.5))}
.fp-chathead{display:flex;align-items:center;gap:8px;padding:2px 2px 8px;border-bottom:1px solid rgba(217,164,65,.35)}
.fp-chatacts{display:flex;gap:5px;flex-wrap:wrap;padding:8px 2px}
.fp-chatacts--row{flex-wrap:nowrap}
.fp-chatacts--row .fp-btn{flex:1 1 auto;min-width:0;padding:0;border-width:9px 9px;border-image-width:9px 9px;font-size:13px;overflow:hidden;text-overflow:ellipsis}
.fp-msgs{display:flex;flex-direction:column;gap:6px;padding:4px 2px}
.fp-msg{max-width:84%;padding:2px 4px;font-size:14px;line-height:1.3;word-wrap:break-word;overflow-wrap:anywhere;align-self:flex-start;color:var(--rs-text);
  border-style:solid;border-width:8px 10px;border-image:${r("kit.tooltip")} 40 42 fill / 8px 10px stretch;image-rendering:pixelated}
.fp-msg--me{align-self:flex-end;border-image-source:${r("kit.panelEmerald")};border-image-slice:80 fill}
.fp-msg time{display:block;font-size:10px;color:var(--rs-dim);margin-top:2px}
.fp-compose{position:relative;display:flex;gap:6px;padding:12px 0 0}
.fp-compose .fp-input{flex:1 1 auto;min-width:0;min-height:40px;padding:0 4px;border-width:9px 10px;border-image-width:9px 10px;font-family:var(--rs-font-body);font-weight:500;font-size:14px;color:var(--rs-text);text-overflow:ellipsis}
.fp-compose .fp-btn{flex:none}
.fp-composer{padding:0 2px 6px}
.fp-count{font-size:10px;color:var(--rs-dim);text-align:right;padding:3px 8px 0}
.fp-radio{display:flex;align-items:center;gap:10px;margin:6px 4px;font-size:14px;cursor:pointer}
.fp-radio input{appearance:none;-webkit-appearance:none;flex:none;width:22px;height:22px;margin:0;cursor:pointer;background:${r("kit.checkbox")} center/contain no-repeat;image-rendering:pixelated}
.fp-radio input:checked{background:${r("kit.check")} 55% 40%/90% no-repeat,${r("kit.checkbox")} center/contain no-repeat}
