import{h as ne,k as L,S as xe}from"./pixi-C51sOOym.js";import{fk as $e,ly as Ve,mo as _e,hX as le,nw as S,ab as F,mk as Qe,m0 as Ie,eF as te,mg as We,gL as M,h1 as Ke,fo as Je,dh as je,cB as Ye,h$ as Xe,ni as $,eR as Me,k4 as Te}from"./index-DeThnM5k.js";import{R as Ze,C as Ue,d as er,e as rr,r as sr,k as ar,a as nr,g as lr,b as tr}from"./cardFace-Ba3Pcm8G.js";import{s as ir,cq as or,eP as z,ds as N,dr as ur,C as dr,c5 as cr}from"./content-WdYfOPLd.js";import{a as pr}from"./questView-Cp0Qhybv.js";import"./vendor-rPUmkxqZ.js";import"./goldenCard-CEheP8kC.js";import"./forgedCard-C40E1dsC.js";import"./duelReducer-wnEpbgtk.js";const De={"knight.swordCut":"Le soleil se couche sur la cour du château. L’ennemi, lui, se couche un peu plus tôt.","knight.shieldUp":"Une croix blanche sur fond rouge : la seule chose qu’un archer de Nordmark ait appris à détester.","knight.bash":"Le bouclier sert à protéger. Mais rien n’interdit de s’en servir pour convaincre.","knight.manAtArms":"« Personne ne passe sans mot de passe. Et je ne connais pas le mot de passe. »","knight.squire":"Il astique l’écu de son seigneur jusqu’à s’y voir chevalier.","knight.ironWave":"L’épée avance, le bouclier suit. Le reste de l’armée de Camelot fait pareil, en moins bien.","knight.trip":"Les bardes oublient toujours la partie où le héros tombe dans la boue. Lui, il s’en souvient.","knight.pommel":"Le pommeau, c’est la partie de l’épée qu’on n’enseigne pas aux écuyers. Pas encore.","knight.shieldWall":"Sur la colline, cent boucliers rouges. Derrière, cent hommes qui prient pour que le voisin tienne.","knight.backbone":"« La carte ment toujours un peu. Les cicatrices, jamais. » — Vétéran de Caer Halwyn","knight.bannerBearer":"Le dragon d’or claque au vent. Aucun soldat de Logres n’a jamais su lui tourner le dos.","knight.crossbowman":"Il met une minute à recharger. L’ennemi, lui, met une éternité à s’en remettre.","knight.halberd":"Les forgerons de Caer Gwynn signent chaque lame. Les survivants s’en souviennent.","knight.heavyStrike":"Le gobelin a vu l’épée monter. Il n’a pas eu le temps de la voir descendre.","knight.cleave":"La meute l’a encerclé. C’est exactement ce qu’il espérait.","knight.pyramid":"« D’abord tu te caches. Ensuite tu frappes. L’ordre compte. » — Maître d’escrime Ladrin","knight.battleCry":"Son souffle fume dans l’air glacé. Ses mots brûlent un peu plus.","knight.trueNorth":"« Regarde, écoute, puis frappe. » La seule leçon que les maîtres d’armes de Camelot répètent deux fois.","knight.anchor":"L’ogre pèse trois fois son poids. Le chevalier pèse une conviction de plus.","knight.templarsStand":"Frapper un templier, c’est comme embrasser un roncier : on le regrette tout de suite.","knight.sergeant":"« Trente hivers sur ces remparts. Si tu veux passer, reviens dans trente autres. »","knight.swordSaint":"Trois coups ont déjà été portés. On n’a vu qu’un seul geste. Caerleon forme ses lames ainsi.","knight.inflame":"Dans le noir, son épée rougeoie comme une forge. Sa colère, plus encore.","knight.lastStand":"Sur le pont en ruine, la dernière bannière brûle. Personne n’a dit qu’il fallait vivre.","knight.roundTableKnight":"Une table ronde, pour que nul ne siège plus haut. Et nul ne recule plus vite.","knight.crusadersWrath":"Le sol se fend sous une colonne de feu doré. La prière était courte. La réponse, non.","knight.shieldSquare":"Sur la plaine de Badon, la cavalerie a chargé le carré. La plaine s’en souvient. La cavalerie, moins.","knight.gawain":"À l’aube, un bon chevalier. À midi, une légende. Bats-le la nuit, si tu tiens à vivre.","knight.excalibur":"« Celui qui tire cette épée de la pierre est roi de droit de toute l’Angleterre. » Le lac a la mémoire longue.","knight.arthur":"Rex quondam, rexque futurus. Le roi qui fut, le roi qui sera — et ce soir, le roi qui frappe.","cleric.pyre":"Le squelette avait survécu à sa propre mort. Il n’a pas survécu au sermon.","cleric.litany":"« Chaque verset est une maille. J’ai beaucoup de versets. » — Sœur Aldwyn","cleric.mend":"Sous la tente de l’hospice, ses mains chaudes valent plus que tous les onguents de Viroconium.","cleric.vesper":"Au clocher de l’abbaye, la cloche des vêpres sonne. Et la lumière, elle, sait où frapper.","cleric.acolyte":"Sa bulle dorée tient bon. Sa bougie, un peu moins.","cleric.sister":"Une croix rouge, des bandages et un regard qui interdit de mourir sans permission.","cleric.bulwark":"Un mur de lumière, solide comme la pierre. Les flèches de Nordmark l’ont appris à leurs dépens.","cleric.tend":"Du lin propre, un feu de camp et un psaume murmuré : la guerre attendra jusqu’à demain.","cleric.hymn":"Les moines chantent juste. La brute, elle, comprend surtout qu’elle a perdu l’envie de se battre.","cleric.censer":"L’encens monte vers le ciel. Les braises, elles, descendent sur le démon.","cleric.blessing":"« Allez, et que la Lumière marche devant vous. Elle a meilleure vue que vous. »","cleric.smite":"La goule a levé les yeux vers le ciel. C’était sa dernière erreur.","cleric.faithfulStrike":"Une masse, un halo et la conviction absolue d’avoir raison. Le combo préféré de Logres.","cleric.pilgrimsStep":"Les tours de Camelot à l’horizon, et cent lieues de brume entre elles et lui.","cleric.templeGuard":"Il garde les portes de la cathédrale depuis vingt ans. Personne n’a encore trouvé la sortie de secours.","cleric.vigil":"Les cierges ont fondu. La nuit aussi. Il ne reste que la prière, et l’aube dans le vitrail.","cleric.divineAegis":"Elle lève la relique, et l’acier ennemi se met soudain à glisser comme sur la glace.","cleric.sanctuary":"Dehors, la bataille fait rage. Dedans, on n’entend que les cierges crépiter.","cleric.salvation":"« Pas encore, chevalier. Le ciel n’a pas fini de te prêter. »","cleric.holyFire":"Une liche craint peu de choses. Le feu blanc d’une clerc en colère en fait partie.","cleric.smoulderingVow":"Elle a juré tout bas. Les braises, elles, ont tout entendu.","cleric.monk":"Le moine de Caer Witrin ne porte pas d’arme. Il en a vu l’usage, et préfère réparer.","cleric.innerLight":"Une flamme qui ne s’éteint ni sous la pluie de Cornouailles, ni sous la neige de Nordmark.","cleric.rally":"Les cloches sonnent. L’abbaye se vide. Les acolytes marchent au front, bougie en main.","cleric.highPriest":"Dans les vergers d’Avalon, les pommes sont d’or et le haut-prêtre ne connaît pas l’hiver.","cleric.finalPyre":"Le grand bûcher monte jusqu’aux étoiles. Les morts-vivants n’en redescendront pas.","cleric.miracle":"À Glastonbury, l’aubépine a fleuri sous la neige. Les blessés se sont levés pour la voir.","cleric.viviane":"« J’ai donné une épée à un roi. Pour toi, ce sera la vie. Choisis mieux que lui. » — Viviane","cleric.holyGrail":"Cent chevaliers ont parcouru le monde pour le trouver. Il attendait que quelqu’un le mérite.","cleric.merlin":"« J’ai déjà vu la fin de ce combat. Ne t’inquiète pas : tu y as le beau rôle. » — Merlin","berserker.reckless":"Il a laissé son bouclier au drakkar. Il a aussi laissé le doute.","berserker.brace":"Le vent hurle, la neige mord. Il serre les dents et attend que le monde se fatigue.","berserker.howl":"Il hurle à la lune. Quelque part dans la forêt de Niðavellir, quelque chose lui répond.","berserker.cleave":"Trois trolls. Une hache. L’arithmétique de Nordmark est d’une simplicité rassurante.","berserker.raider":"Il saute du drakkar avant même que la proue ne touche la grève. Les galets s’en souviennent.","berserker.ulfhednar":"Sous la peau de loup, deux yeux jaunes. Plus rien d’humain ne regarde par là.","berserker.berserk":"Il mord le rebord de son bouclier. Le bouclier a perdu. Toi, tu es le suivant.","berserker.bloodlet":"Quelques gouttes sur les runes, et la neige se met à luire. Odin aime les offrandes sincères.","berserker.smash":"Le marteau frappe, le bouclier éclate, le givre vole. L’homme de Nordmark appelle ça « dire bonjour ».","berserker.wildStrike":"Il saigne. Eux, beaucoup plus. C’est ce qu’on appelle un bon échange à Ulfsdal.","berserker.ironCharge":"La palissade a tenu dix ans contre les trolls. Elle n’a pas tenu dix secondes contre lui.","berserker.frenzy":"Deux haches, une tempête de neige et assez de rage pour réchauffer tout Hrafnborg.","berserker.roar":"Le fjord gelé a frémi. Les pins ont lâché leur neige. L’ennemi a lâché ses armes.","berserker.mularnAxe":"Ébréchée, barbue, plantée dans une souche. Comme son ancien propriétaire, en fait.","berserker.troll":"On ne calme pas un troll enragé. On se contente de le pointer vers l’ennemi et de s’écarter.","berserker.battleDrink":"« Une corne pour les blessures, une pour le courage, et une pour la route. » — Proverbe d’Ulfsdal","berserker.bonebreaker":"Le gourdin a craqué. Le bras aussi. Le marteau, lui, n’a même pas remarqué.","berserker.warBellow":"Les corbeaux s’envolent de l’arbre mort. Ils savent qu’il y aura bientôt à manger.","berserker.rampage":"Les tentes s’effondrent, le camp brûle. Il ne s’arrête pas : il change simplement de cible.","berserker.wildThrow":"La hache tournoie au-dessus du lac gelé. Fuir était une bonne idée. Fuir plus vite aurait été mieux.","berserker.packLeader":"Il ne commande pas la meute. Il court devant, et la meute n’a jamais réussi à le dépasser.","berserker.crushingBlow":"La glace vole en éclats sous la masse. Les skaldes de Hrafnborg en feront une chanson. Courte.","berserker.berserkersPath":"Un chemin rouge dans la neige, un horizon en flammes. Aucun berserker n’a jamais pris le retour.","berserker.lastRoar":"À genoux, il rugit vers le ciel. Les nuages s’ouvrent : le Valhalla a entendu.","berserker.carnage":"Au coucher du soleil, il reste debout au milieu du champ. Il est le seul.","berserker.jarl":"« Mes terres s’étendent jusqu’où porte ma hache. Et je lance très loin. » — Jarl Hrolf","berserker.berserkergang":"La brume rouge descend. Le monde se teinte de sang. Il ne reconnaît plus amis ni ennemis.","berserker.valkyrie":"Elle plonge des nuées d’orage, lance pointée. Aujourd’hui, c’est elle qui choisit les morts.","berserker.mjollnir":"Seul celui qui en est digne peut le soulever. Les autres peuvent toujours essayer de l’esquiver.","berserker.fenrir":"Les dieux l’ont enchaîné par la ruse. Gleipnir vient de céder. Le Ragnarök commence ici.","skald.chord":"Une seule corde pincée, et le draugr découvre que la musique peut trancher.","skald.verse":"Deux rimes, deux lames de son. Les meilleurs vers sont ceux qui laissent des cicatrices.","skald.refrain":"Dans la halle, les runes répètent son chant. Les buveurs aussi, mais moins juste.","skald.lull":"« Dors, géant. Le skald veille. » Le géant s’endort. Le skald, lui, aiguise sa hache.","skald.saga":"Gravée sur une pierre runique sous la neige. Les corbeaux la lisent mieux que les hommes.","skald.lurPlayer":"Le grand lur de bronze sonne sur la falaise. Tout le fjord sait qu’il est temps de prendre les armes.","skald.shieldSinger":"Elle frappe son bouclier en cadence. Derrière elle, tout le mur marche au rythme.","skald.boneChime":"Dans la sombre Járnviðr, les os des vaincus tintent au vent. Ils chantent faux, mais fort.","skald.strophe":"Une strophe pour respirer, une rune pour tenir. Les skaldes n’improvisent jamais leur défense.","skald.marchingSong":"« Gauche, droite, et que les trolls tremblent ! » — Chant de marche de Fort-Givre","skald.songOfSteel":"Sa lame chante. Celles de ses compagnons reprennent le refrain.","skald.ballad":"Dans la fumée, l’ennemi voit sa propre mort. La ballade est déjà écrite, il ne manque que la fin.","skald.hymnShield":"Les flèches rebondissent sur un dôme de runes. Il suffisait de chanter assez fort.","skald.cantata":"Au troisième couplet, toute la halle est debout. Au quatrième, tout le monde a une hache à la main.","skald.windVerse":"Le vent du nord récite avec elle. Il a la voix glacée et des lames pour consonnes.","skald.huscarl":"Garde du corps du jarl. Il connaît toutes les chansons, et les chante toutes faux.","skald.echoesOfIron":"À Nidavellir, chaque coup de marteau des nains résonne encore cent ans plus tard.","skald.riff":"Elle bondit au milieu d’une note. La lame la suit, puis la vague de son, puis l’ennemi par terre.","skald.battleHymn":"Perchée sur son rocher, elle chante. Les guerriers passent en courant : ils n’ont plus peur de rien.","skald.anthem":"Sous l’aurore boréale, une armée entière chante d’une seule voix. Même Hel doit l’entendre.","skald.refrainOfFrost":"Le givre se répand au rythme du refrain. Les ennemis n’arrivent plus à suivre la mesure.","skald.runeSword":"Plantée dans l’autel enneigé, elle s’éveille au moindre couplet. Elle adore les chants de guerre.","skald.echoChamber":"Brassé du sang de Kvasir, le plus sage des hommes. Une gorgée, et le plus muet des skaldes devient poète.","skald.endlessSaga":"La saga se déroule dans le ciel nocturne. Tant qu’un skald la chante, elle n’a pas de fin.","skald.sagaOfHrothgar":"Trois coups contre le serpent de mer, trois strophes sur la tapisserie. Une seule légende.","skald.thane":"Quand il lève sa corne dorée, toute la halle se lève avec lui. Et boit avec lui. Longtemps.","skald.finalVerse":"Six lames de son contre un dragon. Le poème est fini. Le dragon aussi.","skald.valhallaSong":"Les portes d’or s’ouvrent au son des cors. Les einherjar reviennent quand la chanson est belle.","skald.freyja":"Sa cape de plumes de faucon couvre ceux qu’elle aime. Ses chats griffent les autres.","skald.bragi":"Des runes gravées sur la langue. Chaque vers qu’il chante devient vrai, alors il choisit bien ses rimes.","skald.odin":"Il a donné un œil pour la sagesse. Huginn lui dit ce qui se passe. Muninn, ce que tu as oublié.","warden.thornlash":"Le gobelin voulait cueillir une ronce. La ronce a eu la même idée.","warden.briar":"Une rose sauvage et ses épines : belle à regarder, douloureuse à toucher. Comme son porteur.","warden.resilience":"Le vieux chêne plie sous l’orage. Le Protecteur, à son pied, ne plie même pas.","warden.bramble":"Les ronces jaillissent du sol de la forêt. Les soldats regrettent soudain leurs jambières en tissu.","warden.sapling":"Il n’a que trois cernes et des feuilles en guise de cheveux. Mais il ne bougera pas.","warden.thornSpirit":"Un murmure dans les haies de Lough Gur, une lueur verte, puis des épines partout.","warden.sting":"L’araignée géante a huit yeux. Une seule fléchette empoisonnée suffit pourtant.","warden.garden":"Même sur un champ de bataille, quelque chose finit toujours par fleurir.","warden.sprout":"Une pousse fend la pierre. Patience : la forêt a tout son temps, et toi pas.","warden.vinewall":"Le sanglier a chargé. Les lianes se sont tressées plus vite. Le mur a gagné.","warden.briarShield":"« Frappe-le. Vas-y. Je t’en prie. » — Protecteur de Mag Mell","warden.forestsReply":"Le bûcheron a levé sa hache sur le mauvais arbre. La forêt n’oublie jamais une hache.","warden.bogStep":"Elle traverse la tourbière sans un bruit. Derrière, l’ennemi s’enfonce, et le marais rote.","warden.callSpirits":"Il siffle trois notes. Les buissons répondent, puis les creux des arbres, puis toute la clairière.","warden.rootGuard":"Racines tordues, yeux verts et une branche en guise de massue. Abats-le : il repousse.","warden.wreath":"Tressée sur l’autel moussu du bosquet sacré, au premier jour du printemps.","warden.briarKing":"Sa couronne est d’épines, son trône un roncier. Il n’a jamais eu besoin de coussin.","warden.brambleBurst":"Le roncier explose comme une grenade de bois. Les épines, elles, ne choisissent pas leur cible.","warden.bogTrick":"Les feux follets dansent sur le marais. Le guerrier les suit. Le marais, lui, attend.","warden.healingSpring":"La biche blessée boit, le Protecteur aussi. L’eau de Connla ne fait pas de différence.","warden.bloomBurst":"D’un seul coup, toute la clairière fleurit. Le pollen rend même les trolls sentimentaux.","warden.ancientOak":"Un visage sévère dans l’écorce, mille ans de patience et des épines tout le long du tronc.","warden.thornCrown":"Une couronne d’épines lumineuses. Chacune est une promesse, et elles piquent toutes.","warden.witchwall":"Une haie noire autour de la chaumière, pleine de charmes de sorcière. Elle pousse vers toi.","warden.groveKeeper":"Les arbres se penchent vers lui pour le protéger. Il connaît le nom de chacun.","warden.briarQueensHymn":"Quand la Reine des ronces chante, la forêt se referme. Et elle connaît beaucoup de couplets.","warden.entanglingRoots":"La terre d’Ériu retient ceux qu’elle n’aime pas. Elle n’aime pas grand monde.","warden.tirNaNogWarden":"Derrière lui, le printemps éternel de Tír na nÓg. Devant lui, toi. Il n’a aucune raison de bouger.","warden.cuChulainn":"Il s’est attaché à une pierre pour mourir debout. La Gáe Bolga, elle, n’a jamais manqué sa cible.","warden.nuada":"Il perdit sa main, puis son trône. On lui forgea une main d’argent. Il reprit le reste lui-même.","enchantress.sting":"Un éclat violet du bout du doigt. Le gobelin ne comprend pas d’où vient la douleur.","enchantress.mist":"Où est-elle ? Partout. Nulle part. Derrière toi, probablement.","enchantress.bind":"Des fils d’argent que personne ne voit. Sauf le troll, qui les sent très bien.","enchantress.glamour":"Il lève son épée… la regarde… et se demande pourquoi il est venu.","enchantress.familiar":"Grands yeux, volutes violettes, et un appétit insatiable pour la magie de sa maîtresse.","enchantress.pixie":"Il rit, il pique, il disparaît dans un trèfle. Bonne chance pour le retrouver.","enchantress.trickStarter":"Un clin d’œil, une carte qui apparaît dans sa main. Le tour a déjà commencé.","enchantress.pinpoint":"Il y a un défaut dans chaque visière. Elle le trouve toujours du premier coup.","enchantress.quickCut":"Un croissant de lune dans la forêt nocturne. À peine un souffle, et c’est déjà fini.","enchantress.sleight":"« Regarde bien l’orbe. Non, pas celle-là. Ni celle-là. Trop tard. »","enchantress.whisper":"Quelques mots dans la vieille langue d’Ériu à l’oreille, et les genoux du guerrier fléchissent.","enchantress.bondOfGrowth":"Elle lui donne un peu de sa propre lumière. Il grandit. Il réclame déjà la suite.","enchantress.veil":"Un voile de lumière tissé par les fées de la Shannon. Il ne se froisse jamais.","enchantress.witchStep":"Elle connaît les sentiers que les cartes ne montrent pas. Les cartes ont peur de les montrer.","enchantress.underhillBolt":"Sous la colline des fées, une lumière attend. Elle ne remonte que pour frapper.","enchantress.glamouredEdge":"La blessure est minuscule. La brume violette qui s’en échappe, beaucoup moins.","enchantress.callFamiliar":"Elle prononce son vrai nom devant le tertre. La colline s’ouvre, et il accourt.","enchantress.wispLight":"Trois lueurs dans le marais. Le voyageur les a suivies. Ne suis jamais la lumière.","enchantress.witchsBargain":"La vieille sorcière sourit au-dessus du chaudron. Le prix est juste. Il est seulement payé plus tard.","enchantress.bondOfPower":"Un fil violet les relie. Ce qu’elle sait, il le sait. Ce qu’elle veut, il l’arrache.","enchantress.mindTangle":"Les ennemis se regardent, perdus, comme au sortir d’un rêve trop long.","enchantress.misdirect":"Dans la galerie des miroirs, ils frappent son reflet. Puis le reflet du reflet.","enchantress.spireTrick":"Le plus vieux tour du monde, joué sous un tertre des Sídhe. Il marche toujours.","enchantress.soulBond":"Deux silhouettes, une seule aura. Quand l’un respire, l’autre grandit.","enchantress.underhillChampion":"Armure d’écorce et de cristal, yeux violets. Il obéit à la plus petite voix de la colline.","enchantress.finalHex":"Un sceau violet s’étend sur toute l’armée ennemie. Le dernier mot lui revient toujours.","enchantress.niamh":"Elle a emmené Oisín au-delà des mers. Trois cents ans ont passé en un seul soir.","enchantress.arcaneStorm":"Au-dessus du Connacht, le ciel devient blanc. Puis aveuglant. Puis silencieux.","enchantress.morrigan":"Au gué, la Reine Fantôme lave l’armure de ceux qui vont mourir. Elle a déjà commencé la tienne.","enchantress.spearOfLugh":"Balor a ouvert son œil maudit. Lugh n’a eu besoin que d’un seul lancer.","paladin.swordOath":"« Je jure par cette lame de ne frapper que le mal. » Le mal, lui, n’a rien juré du tout.","paladin.brokenShield":"Chaque bosse est une prière exaucée. Ce bouclier a été beaucoup exaucé.","paladin.knightsPrayer":"« Seigneur, garde ceux qui marchent à mes côtés. Moi, je garderai ceux d’en face. »","paladin.recruit":"Son armure blanche est deux tailles trop grande. Sa foi, elle, est pile à sa mesure.","paladin.templar":"Les templiers de Caer Witrin ne reculent pas. Ils ne savent même pas comment on fait.","paladin.greyPrayer":"Le premier rayon de soleil sur le rempart, et la journée est bénie. L’ennemi l’ignore encore.","paladin.sealOfLight":"Une cire dorée, un serment ancien. Ce sceau-là ne se brise pas, même sous l’épée.","paladin.crackedHilt":"La garde est fêlée depuis la bataille de Caer Morvael. La lame, elle, brille toujours.","paladin.judgement":"Le marteau tombe comme le maillet d’un juge. Le démon n’a pas eu droit à un avocat.","paladin.holyArmour":"Bénie sur l’autel de Camelot. La lumière s’infiltre dans l’acier et n’en ressort jamais.","paladin.healingHands":"Des gantelets de guerrier, une chaleur de prêtre. Le paysan ne savait pas qu’on pouvait être les deux.","paladin.blessedHammer":"Il sonne comme une cloche à chaque coup. Le mal entend la messe malgré lui.","paladin.consecration":"Un cercle d’or s’étend sous ses genoux. Ce sol est saint désormais. Pour lui seul.","paladin.steed":"Caparaçonné de blanc et d’un soleil d’or, il charge souvent avant même qu’on le lui demande.","paladin.sealOfPenance":"Le sac de pénitence par-dessus l’armure : on n’est jamais trop humble pour frapper fort.","paladin.faithwardRust":"Un rempart de lumière se dresse devant lui. Il est exactement aussi haut que sa foi.","paladin.brokenStrike":"Le chevalier noir pensait que la vertu était une faiblesse. Il a eu peu de temps pour changer d’avis.","paladin.exorcism":"« Hors de ce corps ! Hors de Logres ! Et ne repasse pas le Mur de Sévère ! »","paladin.blessingOfKings":"Le sceptre d’or touche chaque épaule. La même bénédiction qu’Uther reçut jadis.","paladin.aegis":"Une seule égide de lumière, et toute la ligne des chevaliers de Logres devient intouchable.","paladin.crusader":"Il a pris la croix rouge à Camelot et levé l’épée vers le ciel. Le ciel n’a pas osé refuser.","paladin.devotionAura":"Il entonne le chant de l’Ordre du Graal. Les flèches dévient d’elles-mêmes, gênées de l’interrompre.","paladin.avengingLight":"Pour chaque frère tombé, un rayon de lumière. Ce soir, le ciel est très lumineux.","paladin.lastSermon":"« Écoutez bien, car je ne le répéterai pas. » Les morts-vivants n’ont pas écouté.","paladin.championOfLight":"Au grand tournoi de Camelot, on ne l’a jamais vu poser un genou à terre. Sauf pour prier.","paladin.ashenOath":"Il a juré sur les cendres de sa chapelle. Elles fument encore. Lui aussi.","paladin.percival":"Un garçon des bois gallois devenu chevalier du Graal. Il a vu ce que Lancelot n’a jamais vu.","paladin.holyLance":"Sa pointe saigne une lumière d’or qui ne tarit jamais. Le Roi Pêcheur l’attend toujours.","paladin.galahad":"Le Siège périlleux a foudroyé tous ceux qui s’y sont assis. Pour lui, il s’est illuminé.","paladin.lancelot":"Le plus grand chevalier du monde. Le plus coupable aussi. Mais quand il charge, on oublie le reste.","seer.foresight":"Dans la lueur du gui, il a vu ce coup avant de le porter. L’ennemi, lui, ne l’a pas vu du tout.","seer.claw":"Ses ongles s’allongent, noirs et courbes. À Ériu, la manucure ne plaisante pas.","seer.veil":"L’épée glisse sur sa peau d’écorce. Il n’a même pas cligné des yeux.","seer.stagSpirit":"Là où se posent ses sabots, la mousse et les fleurs repoussent.","seer.shapeshifter":"Mi-homme, mi-ours, entièrement en travers de ton chemin.","seer.moonbeam":"La lune d’Ériu est plus froide qu’ailleurs. Et elle vise mieux.","seer.wolfForm":"Quatre pattes, un pelage gris, deux yeux verts. Et l’odeur de ta peur, très nette.","seer.glimpse":"Dans l’eau du chaudron de bronze, deux chemins brillent. Il prendra les deux.","seer.bearForm":"Il se dresse sur ses pattes arrière, énorme. Toute la forêt se tait d’un coup.","seer.rejuvenation":"La sève verte monte dans ses veines. Ses plaies se referment comme une écorce neuve.","seer.wildGrowth":"Une saison entière de croissance en un seul battement de cœur.","seer.starcast":"Trois étoiles filantes au-dessus du Connacht. Fais un vœu. L’ennemi, lui, n’a pas le temps.","seer.caveBear":"Il dormait au fond de sa grotte moussue. Quelqu’un a fait du bruit. Quelqu’un va le regretter.","seer.deepDraw":"Il pose la main sur les racines du vieil arbre. Les racines savent ce que les branches ignorent.","seer.omen":"Un vol de corneilles au-dessus du cercle de pierres. Mauvais présage. Pour l’autre camp.","seer.thirdEye":"Son troisième œil s’ouvre. Il voit deux fois plus. Il agit deux fois plus vite.","seer.catForm":"Un bond sans un bruit, des griffes déployées. La panthère ne prévient jamais.","seer.wrath":"Grêle, épines et guêpes, tout à la fois. La forêt avait gardé ça pour une grande occasion.","seer.swipe":"Une patte d’ours large comme un bouclier. Les gobelins volent. Brièvement.","seer.treants":"Les arbres des gorges de Cruachan arrachent leurs racines et se mettent en marche. Lentement. Inexorablement.","seer.whiteStag":"Le voir à l’aube, c’est la promesse d’une victoire. Le chasser, celle d’une malédiction.","seer.wildHeart":"Un cœur de bête bat dans sa poitrine. Les esprits des animaux courent autour de lui.","seer.natureRage":"Des yeux s’allument dans les troncs. Racines et bêtes se ruent en avant : la forêt montre les crocs.","seer.spireSight":"Du haut du chêne sacré, au-delà des collines, il voit Tír na nÓg. Elle aussi le voit.","seer.werebear":"Le cercle de pierres l’a vu entrer homme. Il en est ressorti en armure… et en fourrure.","seer.starfall":"Il tend les mains vers la nuit. La nuit lui répond par une pluie d’étoiles.","seer.wildShape":"Ours, loup et arbre à la fois. Ni homme, ni bête : la forêt elle-même, debout et furieuse.","seer.ancientOfCruachan":"Une barbe de mousse, des yeux d’ambre. Il était déjà vieux quand les Fir Bolg sont arrivés.","seer.danu":"Les fleuves coulent de ses mains. Les Tuatha Dé Danann portent son nom ; la terre porte son visage.","seer.cernunnos":"Le dieu cornu s’assied en tailleur. Cerfs, loups et sangliers s’inclinent. Toi aussi, bientôt.","token.forestSpirit":"Une poignée de feuilles, un peu de mousse et beaucoup de mauvaise humeur.","token.forestSprite":"Il rit dans les fougères, puis mord les chevilles.","token.holyRecruit":"Il a prêté serment ce matin. Ce soir, il le tiendra.","token.wolf":"Un louveteau de la lignée de Fenrir. Il a déjà les dents de son père.","token.huginn":"Pensée. Il vole sur le monde chaque matin et revient tout raconter au Père-de-tout.","token.muninn":"Mémoire. Odin craint plus de le perdre que Huginn. Il n’oublie aucun visage.","token.einherjar":"Mort au combat, nourri au Valhalla, renvoyé au combat. Il ne s’en plaint pas.","token.battleCrow":"Messager de la Morrígan. Quand il se pose sur ton épaule, il est déjà trop tard.","token.treant":"Il a mis trois siècles à pousser et trois secondes à décider qu’il ne t’aimait pas."},ie="<sd>",Ee="</sd>";function Pe(r){const a=r.split(ie).join("").split(Ee).join("").replace(/</g,"‹");return cr(a).split("").join(ie).split("").join(Ee)}function Ae(r,a){return a.includes(ie)&&(r.style.tagStyles={...r.style.tagStyles??{},sd:{fontWeight:"800",fill:tr}}),r}function mr(r){return r.upgrade?{...r,name:`${r.name}+`,cost:r.costShift!==void 0?r.cost:r.upgrade.cost??r.cost,text:r.upgrade.text,effects:r.upgrade.effects,...r.upgrade.exhausts!==void 0?{exhausts:r.upgrade.exhausts}:{}}:r}function hr(r){const{W:a,H:n,atlas:b}=r,l=r.upgraded?mr(r.def):r.def,w=Ze[l.rarity],g=l.rarity==="legendary",O=l.rarity==="epic",x=new ne;x.label="CardInspect";const U=Ve(a,n,{color:262918,alpha:.8});U.eventMode="static",U.cursor="pointer",U.on("pointerdown",()