.rs-guide .rs-modal-panel{width:min(620px,calc(100vw - 24px));text-align:left;padding:14px 10px 4px}
.rs-guide-dots{display:flex;justify-content:center;gap:7px;margin:0 0 8px}
.rs-guide-dot{width:9px;height:9px;transform:rotate(45deg);background:#3a2a18;border:1px solid #8a6a3a}
.rs-guide-dot.on{background:#ffd070;border-color:#fff0b8;box-shadow:0 0 6px rgba(255,200,90,.7)}
.rs-guide-page{display:flex;gap:14px;align-items:flex-start}
.rs-guide-icon{flex:none;width:64px;height:64px;padding:6px;border-radius:50%;
  background:radial-gradient(circle at 50% 40%,rgba(255,200,110,.28),rgba(20,10,4,.6) 70%);border:2px solid #8a6a3a;box-shadow:0 0 0 2px #1a0c04,inset 0 0 10px #000}
.rs-guide-icon img{width:100%;height:100%;object-fit:contain;image-rendering:pixelated}
.rs-guide-main{flex:1;min-width:0}
.rs-guide-h{margin:2px 0 6px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:21px;color:#ffe6a8;text-shadow:0 2px 0 #1a0c04}
.rs-guide-list{margin:0;padding:0;list-style:none}
.rs-guide-list li{position:relative;margin:0 0 6px;padding-left:18px;font-size:15px;line-height:1.35;color:#ecdfbf;text-shadow:0 1px 0 #000}
.rs-guide-list li::before{content:"";position:absolute;left:3px;top:.5em;width:7px;height:7px;transform:rotate(45deg);background:#c0303a;border:1px solid #ffb0a0}
.rs-guide-rw{margin:8px 0 2px;padding:7px 10px 3px;border:2px solid #b08a3a;border-radius:6px;background:linear-gradient(180deg,rgba(70,46,14,.55),rgba(24,14,6,.55));box-shadow:inset 0 0 8px rgba(0,0,0,.6)}
.rs-guide-rw-h{display:flex;align-items:center;gap:6px;margin:0 0 4px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:16px;color:#ffd070;text-shadow:0 1px 0 #000}
.rs-guide-rw-h img{width:18px;height:18px;image-rendering:pixelated}
.rs-guide-rw .rs-guide-list li{font-size:14px;margin-bottom:4px}
.rs-guide-rw .rs-guide-list li::before{background:#ffd070;border-color:#fff0b8}
.rs-guide .rs-modal-row{margin-top:10px}
.rs-guide-foot{display:flex;justify-content:space-between;align-items:center;min-height:44px;margin:0 4px;font-size:13px;color:#bfae88}
.rs-guide-never{display:inline-flex;align-items:center;min-height:44px;min-width:44px;margin:0;background:none;border:0;padding:0 6px 0 2px;cursor:pointer;font:inherit;color:#bfae88;text-decoration:underline;text-underline-offset:3px}
.rs-guide-never:hover,.rs-guide-never:focus-visible{color:#ffe6a8;outline:none}
@media (max-height:460px){
  .rs-guide .rs-modal-panel{width:min(700px,calc(100vw - 16px));padding:8px 6px 0}
  .rs-guide-dots{margin:0 0 4px}
  .rs-guide-icon{width:44px;height:44px;padding:4px}
  .rs-guide-page{gap:10px}
  .rs-guide-h{font-size:17px;margin:0 0 3px}
  .rs-guide-list li{font-size:13px;line-height:1.25;margin-bottom:3px}
  .rs-guide-rw{margin-top:4px;padding:4px 8px 1px}
  .rs-guide-rw-h{font-size:14px;margin-bottom:2px}
  .rs-guide-rw .rs-guide-list li{font-size:12px;margin-bottom:2px}
  .rs-guide .rs-modal-row{margin-top:6px}
