.rs-patch .rs-modal-panel{width:min(560px,calc(100vw - 32px));text-align:left}
.rs-modal.rs-patch{padding-top:40px}
.rs-patch-body{max-height:calc(100vh - 220px);overflow-y:auto;overscroll-behavior:contain;padding:0 10px 4px 4px;margin:0 0 10px;
  scrollbar-width:thin;scrollbar-color:#c9973c rgba(0,0,0,.35)}
.rs-patch-body::-webkit-scrollbar{width:12px}
.rs-patch-body::-webkit-scrollbar-track{background:rgba(0,0,0,.35);border-radius:6px;box-shadow:inset 0 0 0 1px rgba(217,164,65,.25)}
.rs-patch-body::-webkit-scrollbar-thumb{background:${r("kit.thumb")} center/100% 100% no-repeat;image-rendering:pixelated;min-height:30px}
.rs-patch-body:focus,.rs-patch-body:focus-visible{outline:none}
.rs-patch-ver{margin:0 0 18px}
.rs-patch-head{position:relative;display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 10px;margin:0 0 8px;padding-bottom:10px}
.rs-patch-head::after{content:"";position:absolute;left:0;right:0;bottom:0;height:12px;border-style:solid;border-width:0 34px;border-image:${r("kit.divider.gold")} 0 60 fill / 0 34px stretch;image-rendering:pixelated;opacity:.85}
.rs-patch-num{font:700 19px "Almendra",Georgia,serif;color:#ffe6a8;text-shadow:0 2px 0 #000}
.rs-patch-name{font:italic 15px "Alegreya",Georgia,serif;color:#e4d6b4;text-shadow:0 1px 0 #000}
.rs-patch-date{margin-left:auto;font-size:13px;color:#a89878}
.rs-patch-tag{font:700 11px "Almendra",Georgia,serif;letter-spacing:.4px;text-transform:uppercase;color:#fff4dc;text-shadow:0 1px 0 #000;
  padding:0 4px;border-style:solid;border-width:5px 10px;border-image:${r("kit.buttonGreen")} 30 56 fill / 5px 10px stretch;image-rendering:pixelated}
.rs-patch-list{margin:0;padding:0 0 0 22px;font-size:16px;line-height:1.5;color:#f2e6c8;text-shadow:0 1px 0 #000}
.rs-patch-list li{margin:6px 0;list-style:none;position:relative}
.rs-patch-list li::before{content:"";position:absolute;left:-18px;top:.45em;width:9px;height:9px;transform:rotate(45deg);
  background:linear-gradient(135deg,#fff0b8,#e2b350 55%,#9a6420);box-shadow:0 0 0 1px #2a1406}
.rs-patch .rs-modal-row{margin-bottom:2px}
@media (max-height:460px){
  .rs-patch-body{max-height:calc(100vh - 150px);margin-bottom:6px}
  .rs-modal.rs-patch{padding-top:34px}
  .rs-patch-num{font-size:17px}
