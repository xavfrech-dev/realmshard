.rs-rp .rs-modal-panel{width:min(720px,calc(100vw - 24px));text-align:left}
.rs-rp .rs-modal-text{text-align:center;margin:2px 0 10px}
.rs-rp-list{max-height:min(52vh,420px);overflow-y:auto;padding:0 4px;display:flex;flex-direction:column;gap:6px}
.rs-rp-row{display:flex;align-items:center;gap:10px;padding:6px 8px;border-radius:4px;border:1px solid #5a4028;background:rgba(12,6,2,.6)}
.rs-rp-res{flex:none;min-width:92px;max-width:150px;padding:3px 6px;text-align:center;font:700 14px "Almendra",Georgia,serif;border-radius:3px;text-shadow:0 1px 0 #000}
.rs-rp-res.win{background:#3c5a1c;color:#e8ffc8}.rs-rp-res.loss{background:#6a1c22;color:#ffd8d0}
.rs-rp-res.draw{background:#4a4030;color:#f2e6c8}.rs-rp-res.unfinished{background:#2e2a26;color:#cdbb94}
.rs-rp-info{flex:1;min-width:0;line-height:1.25}
.rs-rp-who{font-size:15px;color:#f2e6c8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rs-rp-sub{font-size:13px;color:#b8a888}
.rs-rp-acts{flex:none;display:flex;gap:4px}
.rs-rp-btn{height:32px;min-width:44px;padding:0 9px;cursor:pointer;border-radius:4px;border:2px solid #5a4028;
  background:linear-gradient(#3a2c1e,#1c140c);color:#e4d6b4;font:700 13px "Almendra",Georgia,serif;text-shadow:0 1px 0 #000;white-space:nowrap}
.rs-rp-btn:hover{border-color:#e4c16a;color:#fff4dc}
.rs-rp-btn--go{border-color:#8a7a2c;background:linear-gradient(#4a5a1c,#22300c);color:#f4ffd8}
.rs-rp-btn:focus-visible{outline:2px solid #ffd070;outline-offset:2px}
.rs-rp-empty{padding:18px 8px;text-align:center;color:#cdbb94;font-size:15px}
.rs-rp-code{display:block;width:100%;height:120px;resize:none;padding:8px;border-radius:4px;border:2px solid #8a5a1c;
  background:rgba(12,6,2,.78);color:#f2e6c8;font:12px/1.3 ui-monospace,Consolas,monospace;word-break:break-all;outline:none}
.rs-rp-code:focus{border-color:#e4c16a}
.rs-rp .rs-modal-row{margin-top:10px}
.rs-rp .rs-modal-err{text-align:center}
.rs-rp.rs-mobile .rs-rp-row{flex-wrap:wrap}
.rs-rp.rs-mobile .rs-rp-acts{width:100%;justify-content:flex-end}
.rs-rp.rs-mobile .rs-rp-btn{height:40px;min-width:52px;font-size:14px}
@media (max-width:560px){.rs-rp-row{flex-wrap:wrap}.rs-rp-acts{width:100%;justify-content:flex-end}}
@media (max-height:460px){.rs-rp-list{max-height:46vh}.rs-rp .rs-modal-text{display:none}}
