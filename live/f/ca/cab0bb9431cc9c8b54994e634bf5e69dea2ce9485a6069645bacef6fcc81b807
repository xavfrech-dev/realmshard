import{eq as s}from"./content-CLhFSCES.js";const d={mana:{icon:"stat.mana",color:4889599},attack:{icon:"stat.attack",color:15910464},heroPower:{icon:"ui.star",color:15910986},heroicLevels:{icon:"ach.heroicStory",color:8044799},upgrade:{icon:"forge.hammer",color:8048778}},p=[{id:"basics",icon:"stat.mana",entries:[{id:"mana",example:"knight.squire"},{id:"attack",example:"knight.crossbowman"},{id:"sleeping",example:"knight.crossbowman"},{id:"heroPower"},{id:"armor",example:"knight.shieldUp"},{id:"weapon",example:"knight.excalibur"},{id:"strength",example:"berserker.fenrir"},{id:"weak",example:"curse.doubt"},{id:"vulnerable",example:"curse.stiffness"}]},{id:"minions",icon:"kw.taunt",entries:[{id:"taunt",example:"knight.manAtArms",lesson:"tauntStealth"},{id:"divineShield",example:"cleric.acolyte"},{id:"charge",example:"knight.crossbowman"},{id:"rush",example:"berserker.ulfhednar"},{id:"windfury",example:"knight.swordSaint"},{id:"poisonous",example:"warden.thornSpirit"},{id:"lifesteal",example:"cleric.innerLight"},{id:"stealth",example:"enchantress.veil",lesson:"tauntStealth"},{id:"enrage",example:"knight.backbone"},{id:"cantAttack",example:"neutral.surt"}]},{id:"triggers",icon:"kw.battlecry",entries:[{id:"battlecry",example:"knight.squire",lesson:"aimedBattlecry"},{id:"deathrattle",example:"warden.sprout",lesson:"deathrattle"},{id:"inspire",example:"cleric.vigil"},{id:"combo",example:"enchantress.sting",lesson:"combo"},{id:"secret",example:"paladin.greyPrayer",lesson:"secret"},{id:"quest",example:"quest.necromancer.annwnGates"}]},{id:"spells",icon:"kw.spellDamage",entries:[{id:"spellDamage",example:"skald.thane"},{id:"overload",example:"skald.chord",lesson:"overload"},{id:"discover",example:"knight.trueNorth",lesson:"discover"},{id:"freeze",example:"skald.lull"},{id:"silence",example:"cleric.hymn"},{id:"destroy",example:"knight.heavyStrike"},{id:"transform",example:"sorcerer.polymorph"},{id:"exhaust"},{id:"unplayable",example:"curse.regret"}]},{id:"breach",icon:"kw.pact",entries:[{id:"pact",example:"savage.kelgorFervor",lesson:"pact"}]},{id:"lune",icon:"status.echo",entries:[{id:"avatar",example:"lune.paladin.caradoc"},{id:"incarnation",example:"lune.theurgist.taranis"},{id:"awaken",example:"lune.sorcerer.nimue"},{id:"form",example:"lune.berserker.ulf",lesson:"resonance"},{id:"formEnd",example:"lune.wizard.morwen"},{id:"resonance",example:"lune.necromancer.hornCaller",lesson:"resonance"},{id:"lingering",example:"lune.friar.illtud"},{id:"chooseOne",example:"lune.seer.tuan"}]},{id:"crypts",icon:"kw.bonePit",entries:[{id:"bonePit"},{id:"bones",example:"reaver.yearAndDay"},{id:"pit",example:"warlock.blikjandabol"},{id:"drainPit",example:"reaver.pairPenAnnwn"}]},{id:"heroic",icon:"ach.heroicStory",entries:[{id:"heroicLevels",example:"knight.squire"},{id:"upgrade",example:"knight.shieldUp"}]}],n={tab:"Mécaniques",count:"{n} mécaniques",example:"Exemple",try:"Essayer la leçon",newMechanicTitle:"Nouvelle mécanique",hint:"Toutes les règles : Codex › Mécaniques.","fam.basics":"Les bases","fam.minions":"Serviteurs","fam.triggers":"Déclencheurs","fam.spells":"Sorts et effets","fam.breach":"La Brèche","fam.lune":"La Lune sanglante","fam.crypts":"Les Cryptes","fam.heroic":"Mode Héroïque","name.mana":"Mana","rule.mana":"Chaque tour, tu gagnes 1 cristal de mana (10 au plus) et tous se remplissent. Une carte coûte le nombre écrit en haut à gauche.","name.attack":"Attaque et PV","rule.attack":"Un serviteur frappe avec son Attaque (à gauche) et encaisse sur ses PV (à droite) ; à 0 PV, il meurt.","name.heroPower":"Pouvoir héroïque","rule.heroPower":"La capacité propre à ton héros, à côté de son portrait : une fois par tour, pour son coût en mana.","name.heroicLevels":"Niveaux II et III","rule.heroicLevels":"En mode Héroïque, une carte monte de niveau : le niveau II renforce ses chiffres, le niveau III son effet.","name.upgrade":"Carte améliorée (+)","rule.upgrade":"Dans l’Histoire, le feu de camp améliore une carte pour toute la course : son nom prend un « + » et son effet grandit.","tip.mana":"Dépenser tout ton mana chaque tour est souvent la clé : une carte à 2 et une à 3 valent mieux qu’une seule à 4.","tip.attack":"Quand un serviteur en attaque un autre, les deux s’infligent leurs dégâts en même temps : la cible riposte.","tip.sleeping":"Un serviteur qui vient d’arriver dort (Zzz) : il attaquera au tour suivant, sauf s’il a Charge ou Ruée.","tip.heroPower":"Il ne coûte pas de carte : pense à l’utiliser quand il te reste du mana en fin de tour.","tip.armor":"L’armure ne rend pas de PV : elle protège en plus. Les cartes qui comptent ton armure aiment la garder haute.","tip.weapon":"Quand ton héros attaque un serviteur, celui-ci riposte : surveille les PV de ton héros.","tip.weak":"Une malédiction de l’Histoire peut te l’appliquer : tes coups faiblissent quelques tours, le temps que la Faiblesse s’use.","tip.vulnerable":"Un ennemi Vulnérable encaisse davantage : c’est le moment de frapper fort.","tip.strength":"Les héros de l’Histoire et certains ennemis gagnent de la Force au fil du combat : chaque coup compte alors davantage.","tip.taunt":"Tant qu’un serviteur avec Provocation est en jeu, l’adversaire ne peut viser ni ton héros ni tes autres serviteurs en attaquant.","tip.divineShield":"Le bouclier éclate au premier coup, même d’un seul dégât : frappe d’abord avec ton plus petit serviteur.","tip.charge":"Charge permet de frapper le héros adverse tout de suite : parfait pour finir une partie.","tip.rush":"Ruée sert à nettoyer le plateau dès l’arrivée, sans viser le héros.","tip.windfury":"Deux attaques, c’est deux ripostes possibles : choisis bien tes cibles.","tip.poisonous":"Même 1 dégât suffit : un petit serviteur Toxique fait fuir les gros.","tip.lifesteal":"Un sort peut donner Vol de vie à un serviteur, et certaines Mues le donnent à ton héros.","tip.stealth":"Le Camouflage tombe dès que le serviteur attaque : garde-le caché pour préparer un gros coup.","tip.enrage":"Le bonus s’éteint si le serviteur est soigné complètement.","tip.cantAttack":"Ces serviteurs ont souvent un effet puissant pour compenser : protège-les.","tip.battlecry":"Le Cri de guerre ne se déclenche qu’à la pose depuis la main, pas si le serviteur est invoqué par un autre effet.","tip.deathrattle":"Le Râle d’agonie se déclenche quelle que soit la façon de mourir ; le Silence l’efface.","tip.inspire":"Chaque utilisation du pouvoir héroïque le déclenche : place ces serviteurs avant d’utiliser ton pouvoir.","tip.combo":"Joue d’abord une carte bon marché, puis la carte Combo dans le même tour.","tip.secret":"L’adversaire voit qu’un Secret est posé, pas lequel : il peut essayer de le déclencher exprès.","tip.quest":"Une Quête s’accomplit sur plusieurs tours : construis ton deck autour de son objectif.","tip.spellDamage":"Le bonus s’ajoute à chaque cible d’un sort de zone ; il ne concerne que tes propres sorts.","tip.overload":"Le mana verrouillé apparaît au tour suivant : prévois une carte moins chère pour ce tour-là.","tip.discover":"Les trois cartes sont tirées au hasard, mais c’est toi qui choisis : adapte-toi à la partie.","tip.freeze":"Geler un gros attaquant te fait gagner un tour pour t’en débarrasser.","tip.silence":"Le Silence retire aussi le Gel et le Bouclier divin, mais le serviteur garde son Attaque et ses PV actuels.","tip.destroy":"Le Bouclier divin et les gros PV ne protègent pas d’un effet qui détruit.","tip.transform":"Le serviteur transformé ne meurt pas : son Râle d’agonie ne se déclenche pas.","tip.exhaust":"Ces cartes de l’Histoire sont fortes mais ne servent qu’une fois par combat.","tip.unplayable":"Les malédictions de l’Histoire prennent une place dans ta main sans rien faire : évite d’en accumuler.","tip.pact":"Le Pacte coûte des PV, pas du mana : surveille ta vie avant de payer.","tip.avatar":"Une fois l’Avatar joué, tes cartes à Résonance prennent leur bonus.","tip.incarnation":"Tes PV passent à la valeur indiquée, même s’ils étaient plus hauts : joue-la quand tu es bas.","tip.awaken":"Ton nouveau pouvoir est utilisable tout de suite, même si tu avais déjà utilisé l’ancien ce tour-ci (pendant une Mue, il arrive quand elle prend fin).","tip.form":"Pendant la Mue, ton pouvoir héroïque change : utilise-le à chacun de ces tours pour en profiter.","tip.formEnd":"Si un Avatar, un Éveil ou une Incarnation remplace la Mue avant la fin, cet effet ne se déclenche pas.","tip.resonance":"Une seule transformation suffit pour toute la partie : prépare-la tôt pour profiter de tes cartes à Résonance.","tip.lingering":"Une Rémanence reste après la mort du serviteur et ne peut pas être réduite au silence.","tip.chooseOne":"Choisis selon la situation. Avec Tuan, par exemple, chaque option est une Mue différente, avec sa propre durée.","tip.bonePit":"Chaque serviteur qui meurt, allié ou ennemi, ajoute 1 Ossement : le médaillon de la Fosse, sur le plateau, montre le compte.","tip.bones":"Les Ossements retirés ne reviennent pas : l’adversaire profite aussi de la Fosse, vide-la avant lui.","tip.pit":"Fosse ne retire rien : plusieurs cartes Fosse peuvent profiter du même compte.","tip.drainPit":"Plus la Fosse est pleine, plus l’effet est fort : attends le bon moment.","tip.heroicLevels":"Les chiffres améliorés s’affichent en vert. Dans la grande carte, le bloc « Niveau suivant » montre ce que le prochain niveau apporte.","tip.upgrade":"Une carte améliorée garde son nom suivi d’un « + » jusqu’à la fin de la course."},o={tab:"Mechanics",count:"{n} mechanics",example:"Example",try:"Try the lesson",newMechanicTitle:"New mechanic",hint:"Every rule: Codex › Mechanics.","fam.basics":"The basics","fam.minions":"Minions","fam.triggers":"Triggers","fam.spells":"Spells and effects","fam.breach":"The Breach","fam.lune":"The Blood Moon","fam.crypts":"The Crypts","fam.heroic":"Heroic mode","name.mana":"Mana","rule.mana":"Each turn you gain 1 mana crystal (up to 10) and they all refill. A card costs the number in its top-left corner.","name.attack":"Attack and Health","rule.attack":"A minion strikes with its Attack (left) and takes damage on its Health (right); at 0 Health it dies.","name.heroPower":"Hero Power","rule.heroPower":"Your hero’s own ability, beside its portrait: once per turn, for its mana cost.","name.heroicLevels":"Levels II and III","rule.heroicLevels":"In Heroic mode a card levels up: level II raises its numbers, level III its effect.","name.upgrade":"Upgraded card (+)","rule.upgrade":"In Story, the campfire upgrades a card for the whole run: its name gets a “+” and its effect grows.","tip.mana":"Spending all your mana each turn is often the key: a 2-cost and a 3-cost card beat a single 4-cost.","tip.attack":"When a minion attacks another, both deal their damage at once: the target strikes back.","tip.sleeping":"A minion that just arrived is asleep (Zzz): it attacks next turn, unless it has Charge or Rush.","tip.heroPower":"It costs no card: remember to use it when you have mana left at the end of your turn.","tip.armor":"Armor restores no Health: it protects on top of it. Cards that count your Armor like it high.","tip.weapon":"Your hero takes the strike back too when it attacks a minion: mind its Health.","tip.weak":"A Story curse can apply it to you: your hits weaken for a few turns, until the Weak wears off.","tip.vulnerable":"A Vulnerable enemy takes more: the time to hit hard.","tip.strength":"Story heroes and some enemies gain Strength as the fight goes on: every hit then counts more.","tip.taunt":"While a minion with Taunt is in play, the enemy can’t attack your hero or your other minions.","tip.divineShield":"The shield breaks on the first hit, even of 1 damage: strike with your smallest minion first.","tip.charge":"Charge can hit the enemy hero at once: perfect to finish a game.","tip.rush":"Rush clears the board on arrival, without aiming at the hero.","tip.windfury":"Two attacks mean two strikes back: pick your targets well.","tip.poisonous":"Even 1 damage is enough: a small Poisonous minion scares the big ones.","tip.lifesteal":"A spell can give Lifesteal to a minion, and some Shifts give it to your hero.","tip.stealth":"Stealth falls as soon as the minion attacks: keep it hidden to set up a big blow.","tip.enrage":"The bonus goes away once the minion is fully healed.","tip.cantAttack":"These minions often have a strong effect to make up for it: protect them.","tip.battlecry":"A Battlecry only triggers when played from your hand, not when another effect summons the minion.","tip.deathrattle":"A Deathrattle triggers however the minion dies; Silence removes it.","tip.inspire":"Every use of your Hero Power triggers it: play these minions before using your power.","tip.combo":"Play a cheap card first, then the Combo card in the same turn.","tip.secret":"Your opponent sees that a Secret is set, not which one: they may try to trigger it on purpose.","tip.quest":"A Quest is completed over several turns: build your deck around its goal.","tip.spellDamage":"The bonus applies to each target of an area spell; it only boosts your own spells.","tip.overload":"The locked mana shows next turn: plan a cheaper card for that turn.","tip.discover":"The three cards are random, but you choose: adapt to the game.","tip.freeze":"Freezing a big attacker buys you a turn to deal with it.","tip.silence":"Silence also removes Freeze and Divine Shield, but the minion keeps its current Attack and Health.","tip.destroy":"Divine Shield and high Health don’t protect from an effect that destroys.","tip.transform":"The transformed minion does not die: its Deathrattle does not trigger.","tip.exhaust":"These Story cards are strong but only work once per fight.","tip.unplayable":"Story curses take a place in your hand and do nothing: avoid piling them up.","tip.pact":"A Pact costs Health, not mana: watch your life before you pay.","tip.avatar":"Once the Avatar is played, your Resonance cards get their bonus.","tip.incarnation":"Your Health is set to the value shown, even if it was higher: play it when you are low.","tip.awaken":"Your new power is usable at once, even if you had already used the old one this turn (during a Shift, it arrives when the Shift ends).","tip.form":"During the Shift your Hero Power changes: use it on each of those turns to make the most of it.","tip.formEnd":"If an Avatar, an Awakening or an Incarnation replaces the Shift before it ends, this does not trigger.","tip.resonance":"One transformation is enough for the whole game: set it up early to enjoy your Resonance cards.","tip.lingering":"A Lingering effect stays after the minion dies and can’t be silenced.","tip.chooseOne":"Pick by the situation. With Tuan, for example, each option is a different Shift, with its own length.","tip.bonePit":"Every minion that dies, friend or foe, adds 1 Bone: the Pit medallion on the board shows the count.","tip.bones":"Bones taken never come back: your opponent uses the Pit too, empty it before they do.","tip.pit":"Pit takes nothing: several Pit cards can use the same count.","tip.drainPit":"The fuller the Pit, the stronger the effect: wait for the right moment.","tip.heroicLevels":"Raised numbers show in green. On the big card, the Next level block shows what the next level brings.","tip.upgrade":"An upgraded card keeps its name followed by a “+” until the end of the run."},l={tab:"Mechaniken",count:"{n} Mechaniken",example:"Beispiel",try:"Lektion spielen",newMechanicTitle:"Neue Mechanik",hint:"Alle Regeln: Kodex › Mechaniken.","fam.basics":"Grundlagen","fam.minions":"Diener","fam.triggers":"Auslöser","fam.spells":"Zauber und Effekte","fam.breach":"Die Bresche","fam.lune":"Der Blutmond","fam.crypts":"Die Krypten","fam.heroic":"Heldenmodus","name.mana":"Mana","rule.mana":"Jeden Zug erhaltet Ihr 1 Manakristall (höchstens 10) und alle füllen sich auf. Eine Karte kostet die Zahl oben links.","name.attack":"Angriff und Leben","rule.attack":"Ein Diener schlägt mit seinem Angriff (links) zu und nimmt Schaden an seinem Leben (rechts); bei 0 Leben stirbt er.","name.heroPower":"Heldenfähigkeit","rule.heroPower":"Die eigene Fähigkeit Eures Helden neben seinem Porträt: einmal pro Zug, für ihre Manakosten.","name.heroicLevels":"Stufen II und III","rule.heroicLevels":"Im Heldenmodus steigt eine Karte auf: Stufe II stärkt ihre Werte, Stufe III ihren Effekt.","name.upgrade":"Verbesserte Karte (+)","rule.upgrade":"In der Geschichte verbessert das Lagerfeuer eine Karte für den ganzen Lauf: Ihr Name erhält ein „+“ und ihr Effekt wächst.","tip.mana":"Jeden Zug alles Mana auszugeben ist oft der Schlüssel: eine 2er- und eine 3er-Karte schlagen eine einzelne 4er.","tip.attack":"Greift ein Diener einen anderen an, verursachen beide gleichzeitig Schaden: Das Ziel schlägt zurück.","tip.sleeping":"Ein frisch angekommener Diener schläft (Zzz): Er greift im nächsten Zug an, außer er hat Sturmangriff oder Ansturm.","tip.heroPower":"Sie kostet keine Karte: Setzt sie ein, wenn Euch am Zugende Mana bleibt.","tip.armor":"Rüstung heilt kein Leben: Sie schützt zusätzlich. Karten, die Eure Rüstung zählen, mögen sie hoch.","tip.weapon":"Greift Euer Held einen Diener an, schlägt dieser auch zurück: Achtet auf sein Leben.","tip.weak":"Ein Fluch der Geschichte kann ihn Euch auferlegen: Eure Treffer werden für einige Züge schwächer, bis Schwach abklingt.","tip.vulnerable":"Ein verwundbarer Feind steckt mehr ein: der Moment, hart zuzuschlagen.","tip.strength":"Helden der Geschichte und manche Feinde gewinnen im Kampf Stärke: Jeder Treffer zählt dann mehr.","tip.taunt":"Solange ein Diener mit Spott im Spiel ist, kann der Gegner weder Euren Helden noch Eure anderen Diener angreifen.","tip.divineShield":"Der Schild zerbricht beim ersten Treffer, auch bei 1 Schaden: Schlagt zuerst mit Eurem kleinsten Diener zu.","tip.charge":"Sturmangriff trifft den feindlichen Helden sofort: ideal, um eine Partie zu beenden.","tip.rush":"Ansturm räumt das Feld gleich beim Ankommen, ohne den Helden anzugreifen.","tip.windfury":"Zwei Angriffe heißen zwei Gegenschläge: Wählt Eure Ziele gut.","tip.poisonous":"Schon 1 Schaden genügt: Ein kleiner giftiger Diener schreckt die großen ab.","tip.lifesteal":"Ein Zauber kann einem Diener Lebensentzug verleihen, und manche Wandlungen verleihen ihn Eurem Helden.","tip.stealth":"Verstohlenheit endet, sobald der Diener angreift: Haltet ihn versteckt für einen großen Schlag.","tip.enrage":"Der Bonus verschwindet, sobald der Diener vollständig geheilt ist.","tip.cantAttack":"Diese Diener haben oft einen starken Effekt als Ausgleich: Beschützt sie.","tip.battlecry":"Ein Kampfschrei wird nur beim Ausspielen aus der Hand ausgelöst, nicht wenn ein anderer Effekt den Diener herbeiruft.","tip.deathrattle":"Ein Todesröcheln wird ausgelöst, egal wie der Diener stirbt; Schweigen entfernt es.","tip.inspire":"Jeder Einsatz der Heldenfähigkeit löst es aus: Spielt diese Diener vor Eurer Fähigkeit.","tip.combo":"Spielt zuerst eine günstige Karte, dann die Combo-Karte im selben Zug.","tip.secret":"Der Gegner sieht, dass ein Geheimnis liegt, aber nicht welches: Er kann versuchen, es absichtlich auszulösen.","tip.quest":"Eine Quest wird über mehrere Züge erfüllt: Baut Euer Deck um ihr Ziel.","tip.spellDamage":"Der Bonus gilt für jedes Ziel eines Flächenzaubers; er stärkt nur Eure eigenen Zauber.","tip.overload":"Das gesperrte Mana zeigt sich im nächsten Zug: Plant für diesen Zug eine günstigere Karte.","tip.discover":"Die drei Karten sind zufällig, aber Ihr wählt: Passt Euch der Partie an.","tip.freeze":"Einen großen Angreifer einzufrieren verschafft Euch einen Zug, um ihn loszuwerden.","tip.silence":"Schweigen entfernt auch Einfrieren und Gottesschild, aber der Diener behält seinen aktuellen Angriff und sein Leben.","tip.destroy":"Gottesschild und viel Leben schützen nicht vor einem Effekt, der vernichtet.","tip.transform":"Der verwandelte Diener stirbt nicht: Sein Todesröcheln wird nicht ausgelöst.","tip.exhaust":"Diese Karten der Geschichte sind stark, wirken aber nur einmal pro Kampf.","tip.unplayable":"Flüche der Geschichte belegen einen Platz in Eurer Hand und tun nichts: Sammelt nicht zu viele.","tip.pact":"Ein Pakt kostet Leben, kein Mana: Achtet auf Euer Leben, bevor Ihr zahlt.","tip.avatar":"Ist der Avatar gespielt, erhalten Eure Resonanz-Karten ihren Bonus.","tip.incarnation":"Euer Leben wird auf den Wert gesetzt, auch wenn es höher war: Spielt sie, wenn Ihr wenig Leben habt.","tip.awaken":"Eure neue Fähigkeit ist sofort nutzbar, auch wenn Ihr die alte in diesem Zug schon eingesetzt habt (während einer Wandlung kommt sie, wenn diese endet).","tip.form":"Während der Wandlung ändert sich Eure Heldenfähigkeit: Setzt sie in jedem dieser Züge ein.","tip.formEnd":"Ersetzt ein Avatar, ein Erwachen oder eine Verkörperung die Wandlung vor ihrem Ende, wird dies nicht ausgelöst.","tip.resonance":"Eine einzige Verwandlung genügt für die ganze Partie: Bereitet sie früh vor, um Eure Resonanz-Karten zu nutzen.","tip.lingering":"Ein Nachhall bleibt nach dem Tod des Dieners bestehen und kann nicht zum Schweigen gebracht werden.","tip.chooseOne":"Wählt je nach Lage. Bei Tuan zum Beispiel ist jede Option eine andere Wandlung mit eigener Dauer.","tip.bonePit":"Jeder Diener, der stirbt, ob Freund oder Feind, legt 1 Gebein hinein: Das Grubenmedaillon auf dem Spielfeld zeigt die Zahl.","tip.bones":"Entnommene Gebeine kommen nicht zurück: Auch der Gegner nutzt die Grube, leert sie vor ihm.","tip.pit":"Grube nimmt nichts heraus: Mehrere Grube-Karten können dieselbe Zahl nutzen.","tip.drainPit":"Je voller die Grube, desto stärker der Effekt: Wartet auf den richtigen Moment.","tip.heroicLevels":"Verbesserte Werte erscheinen grün. Auf der großen Karte zeigt der Block „Nächste Stufe“, was die nächste Stufe bringt.","tip.upgrade":"Eine verbesserte Karte behält ihren Namen mit einem „+“ bis zum Ende des Laufs."},u={fr:n,en:o,de:l};function m(e,t){const i=(u[s()]??n)[e]??n[e]??e;return t?i.replace(/\{(\w+)\}/g,(a,r)=>r in t?String(t[r]):a):i}export{d as B,p as M,m};
