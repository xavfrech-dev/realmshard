.rs-guide-rw-h{display:flex;align-items:center;gap:6px;margin:0 0 4px;font-family:"Almendra",Georgia,serif;font-weight:700;font-size:16px;color:#ffd070;text-shadow:0 1px 0 #000}
.rs-guide-rw-h img{width:18px;height:18px;image-rendering:pixelated}
.rs-guide-rw .rs-guide-list li{font-size:14px;margin-bottom:4px}
.rs-guide-rw .rs-guide-list li::before{background:#ffd070;border-color:#fff0b8}
.rs-guide .rs-modal-row{margin-top:10px}
.rs-guide-foot{display:flex;justify-content:space-between;align-items:center;min-height:44px;margin:0 4px;font-size:13px;color:#bfae88}
.rs-guide-never{display:inline-flex;align-items:center;min-height:44px;min-width:44px;margin:0;background:none;border:0;padding:0 6px 0 2px;cursor:pointer;font:inherit;color:#bfae88;text-decoration:underline;text-underline-offset:3px}
.rs-guide-never:hover,.rs-guide-never:focus-visible{color:#ffe6a8;outline:none}
@media (max-height:460px){
  .rs-guide .rs-modal-panel{width:min(700px,calc(100vw - 16px));padding:8px 6px 0}
  .rs-guide-dots{margin:0 0 4px}
  .rs-guide-icon{width:44px;height:44px;padding:4px}
  .rs-guide-page{gap:10px}
  .rs-guide-h{font-size:17px;margin:0 0 3px}
  .rs-guide-list li{font-size:13px;line-height:1.25;margin-bottom:3px}
  .rs-guide-rw{margin-top:4px;padding:4px 8px 1px}
  .rs-guide-rw-h{font-size:14px;margin-bottom:2px}
  .rs-guide-rw .rs-guide-list li{font-size:12px;margin-bottom:2px}
  .rs-guide .rs-modal-row{margin-top:6px}
  .rs-guide-foot{font-size:12px}
}
